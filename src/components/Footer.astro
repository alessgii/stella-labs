---
const year = new Date().getFullYear();
---

<footer class="relative z-10 w-full border-t border-white/10 bg-space-950/90 px-6 py-12 backdrop-blur-md md:px-10 lg:py-16">
  <div class="mx-auto max-w-7xl">
    <!-- Fila superior -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
      <!-- Columna de Marca -->
      <div class="space-y-4 md:col-span-6 lg:col-span-5">
        <a href="/" class="group inline-flex items-center gap-2.5 transition-opacity hover:opacity-90">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 100 100"
            class="h-6 w-6 shrink-0 transition-transform duration-200 group-hover:scale-105"
            aria-hidden="true"
          >
            <defs>
              <linearGradient id="footer-stella-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#38bdf8"></stop>
                <stop offset="100%" stop-color="#1d4ed8"></stop>
              </linearGradient>

              <mask id="footer-stella-mask">
                <rect width="100" height="100" fill="white"></rect>
                <path
                  d="M 50 49 Q 50 64 65 64 Q 50 64 50 79 Q 50 64 35 64 Q 50 64 50 49 Z"
                  fill="black"
                ></path>
              </mask>
            </defs>

            <path
              d="M 40 12 H 60 C 61.5 12 62 13 62 15 C 62 17 61 18 58 18 V 38 L 81.5 76 C 84.5 81 81.5 86 76 86 H 24 C 18.5 86 15.5 81 18.5 76 L 42 38 V 18 C 39 18 38 17 38 15 C 38 13 38.5 12 40 12 Z"
              fill="url(#footer-stella-grad)"
              mask="url(#footer-stella-mask)"
            ></path>
          </svg>

          <span class="text-lg font-semibold tracking-tight text-white">
            Stella<span class="text-astra-400">Labs</span>
          </span>
        </a>

        <p class="font-mono text-sm text-astra-400">
          Por y para estudiantes<span class="text-white">.</span>
        </p>

        <p class="max-w-sm text-xs leading-relaxed text-gray-400">
          Laboratorio experimental de software, utilidades y torneos desarrollado para impulsar la comunidad estudiantil de Teleinformática.
        </p>
      </div>

      <!-- Herramientas -->
      <div class="space-y-3 md:col-span-3 lg:col-span-4">
        <p class="font-mono text-xs uppercase tracking-wider text-gray-300">Herramientas</p>
        <ul class="space-y-2 text-sm text-gray-400">
          <li>
            <a href="/eventos" class="transition-colors hover:text-white">
              Registro de eventos
            </a>
          </li>
          <li>
            <a href="/torneos" class="inline-flex items-center gap-2 transition-colors hover:text-white">
              <span>Torneos de videojuegos</span>
              <span class="rounded bg-cosmic-500/20 px-1.5 py-0.5 font-mono text-[10px] text-cosmic-400">Liga</span>
            </a>
          </li>
          <li>
            <a href="/juegos" class="transition-colors hover:text-white">
              Mini juegos
            </a>
          </li>
          <li>
            <a href="/guias" class="transition-colors hover:text-white">
              Guías
            </a>
          </li>
        </ul>
      </div>

      <!-- Navegación -->
      <div class="space-y-3 md:col-span-3 lg:col-span-3">
        <p class="font-mono text-xs uppercase tracking-wider text-gray-300">Navegación</p>
        <ul class="space-y-2 text-sm text-gray-400">
          <li>
            <a href="/" class="transition-colors hover:text-white">
              Inicio
            </a>
          </li>
          <li>
            <a href="/acerca-de" class="transition-colors hover:text-white">
              Acerca de
            </a>
          </li>
          <li>
            <a href="/contacto" class="transition-colors hover:text-white">
              Contacto
            </a>
          </li>
          <li>
            <a
              href="https://teleinformatica.stellalabs.tech"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs text-gray-500 transition-colors hover:text-gray-300"
            >
              Portal de la carrera
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 text-xs text-gray-500 sm:flex-row">
      <p>
        StellaLabs — © {year}. Ingeniería en Teleinformática, CUCSur.
      </p>
      <div class="flex items-center gap-2 font-mono text-[11px] text-gray-400">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Sistemas operativos
      </div>
    </div>
  </div>
</footer>