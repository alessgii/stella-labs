---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const { href, variant = "primary" } = Astro.props;

const base =
  "inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-medium transition-colors duration-200";

const variants = {
  primary: "bg-accent text-bg hover:bg-accent/90",
  secondary:
    "bg-transparent text-gray-400 border border-gray-700 hover:border-gray-500 hover:text-gray-300",
};
---

<a href={href} class={`${base} ${variants[variant]}`}>
  <slot />
</a>
