---
import Badge from "./Badge.astro";
---

<header
  class="sticky top-0 z-50 w-full border-b border-white/10 bg-bg/75 backdrop-blur-md"
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-4 md:px-10">
    <!-- Izquierda: isotipo + logo + badge -->
    <div class="flex items-center gap-3">
      <a href="/" class="group flex items-center gap-2.5 transition-opacity hover:opacity-90">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 100"
          class="h-6 w-6 shrink-0 transition-transform duration-200 group-hover:scale-105"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="header-stella-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8"></stop>
              <stop offset="100%" stop-color="#1d4ed8"></stop>
            </linearGradient>

            <mask id="header-stella-mask">
              <rect width="100" height="100" fill="white"></rect>
              <path
                d="M 50 49 Q 50 64 65 64 Q 50 64 50 79 Q 50 64 35 64 Q 50 64 50 49 Z"
                fill="black"
              ></path>
            </mask>
          </defs>

          <path
            d="M 40 12 H 60 C 61.5 12 62 13 62 15 C 62 17 61 18 58 18 V 38 L 81.5 76 C 84.5 81 81.5 86 76 86 H 24 C 18.5 86 15.5 81 18.5 76 L 42 38 V 18 C 39 18 38 17 38 15 C 38 13 38.5 12 40 12 Z"
            fill="url(#header-stella-grad)"
            mask="url(#header-stella-mask)"
          ></path>
        </svg>

        <span class="text-base font-semibold tracking-tight text-white">
          Stella<span class="text-accent">Labs</span>
        </span>
      </a>
      <Badge />
    </div>

    <!-- Menú de navegación (Desktop) -->
    <nav class="hidden items-center gap-6 text-sm text-gray-400 md:flex">
      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1.5 transition-colors hover:text-white"
        >
          Herramientas
          <svg
            class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>

        <!-- Submenú Desktop -->
        <div
          class="invisible absolute left-0 top-full pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100"
        >
          <div class="w-56 rounded-xl border border-white/10 bg-bg/95 p-1.5 shadow-2xl backdrop-blur-lg">
            <a
              href="/eventos"
              class="block rounded-lg px-3 py-2 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
            >
              Registro de eventos
            </a>
            <a
              href="/torneos"
              class="flex items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
            >
              <span>Torneos</span>
              <span class="rounded bg-cosmic-500/20 px-1.5 py-0.5 text-[10px] font-mono text-cosmic-400">Liga</span>
            </a>
            <a
              href="/juegos"
              class="block rounded-lg px-3 py-2 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
            >
              Mini juegos
            </a>
            <a
              href="/guias"
              class="block rounded-lg px-3 py-2 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
            >
              Guías
            </a>
          </div>
        </div>
      </div>

      <span class="text-white/15">|</span>
      <a href="/acerca-de" class="transition-colors hover:text-white">Acerca de</a>
      <span class="text-white/15">|</span>
      <a href="/contacto" class="transition-colors hover:text-white">Contacto</a>
    </nav>

    <!-- Botón Hamburguesa (Móvil) -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      class="inline-flex items-center justify-center rounded-lg border border-white/10 p-2 text-gray-400 transition-colors hover:bg-white/5 hover:text-white md:hidden"
    >
      <!-- Icono Menú (Hamburguesa) -->
      <svg
        id="icon-menu-open"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <!-- Icono Cerrar (X) -->
      <svg
        id="icon-menu-close"
        class="hidden h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div
    id="mobile-menu"
    class="hidden border-b border-white/10 bg-bg/95 px-6 py-5 backdrop-blur-xl md:hidden"
  >
    <div class="flex flex-col space-y-4">
      <!-- Sección Herramientas -->
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-gray-500">Herramientas & Laboratorio</p>
        <div class="mt-2 space-y-1 pl-2">
          <a
            href="/eventos"
            class="flex items-center gap-2 rounded-lg py-2 text-sm text-gray-300 transition-colors hover:text-white"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-astra-400"></span>
            Registro de eventos
          </a>
          <a
            href="/torneos"
            class="flex items-center justify-between rounded-lg py-2 text-sm text-gray-300 transition-colors hover:text-white"
          >
            <div class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-cosmic-400"></span>
              <span>Torneos de videojuegos</span>
            </div>
            <span class="rounded bg-cosmic-500/20 px-1.5 py-0.5 text-[10px] font-mono text-cosmic-400">Nuevo</span>
          </a>
          <a
            href="/juegos"
            class="flex items-center gap-2 rounded-lg py-2 text-sm text-gray-300 transition-colors hover:text-white"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
            Mini juegos
          </a>
          <a
            href="/torneos"
            class="flex items-center justify-between rounded-lg py-2 text-sm text-gray-300 transition-colors hover:text-white"
          >
            <div class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-cosmic-400"></span>
              <span>Guías</span>
            </div>
            <span class="rounded bg-cosmic-500/20 px-1.5 py-0.5 text-[10px] font-mono text-cosmic-400">Nuevo</span>
          </a>
        </div>
      </div>

      <div class="border-t border-white/10 pt-3 space-y-1">
        <a
          href="/acerca-de"
          class="block rounded-lg py-2 text-sm font-medium text-gray-300 transition-colors hover:text-white"
        >
          Acerca de
        </a>
        <a
          href="/contacto"
          class="block rounded-lg py-2 text-sm font-medium text-gray-300 transition-colors hover:text-white"
        >
          Contacto
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("icon-menu-open");
  const closeIcon = document.getElementById("icon-menu-close");

  btn?.addEventListener("click", () => {
    const isExpanded = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!isExpanded));
    menu?.classList.toggle("hidden");
    openIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  // Cerrar menú al hacer click en cualquier link
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    });
  });
</script>