---
import Badge from "./Badge.astro";
---

<header
  class="sticky top-0 z-50 w-full border-b border-white/10 bg-bg/75 backdrop-blur-md"
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-4 md:px-10">
    <!-- Izquierda: isotipo + logo + badge -->
    <div class="flex items-center gap-3">
      <a href="/" class="group flex items-center gap-2.5 transition-opacity hover:opacity-90">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 100"
          class="h-6 w-6 shrink-0 transition-transform duration-200 group-hover:scale-105"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="header-stella-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8" />
              <stop offset="100%" stop-color="#1d4ed8" />
            </linearGradient>

            <mask id="header-stella-mask">
              <rect width="100" height="100" fill="white" />
              <path
                d="M 50 49 Q 50 64 65 64 Q 50 64 50 79 Q 50 64 35 64 Q 50 64 50 49 Z"
                fill="black"
              />
            </mask>
          </defs>

          <path
            d="M 40 12 H 60 C 61.5 12 62 13 62 15 C 62 17 61 18 58 18 V 38 L 81.5 76 C 84.5 81 81.5 86 76 86 H 24 C 18.5 86 15.5 81 18.5 76 L 42 38 V 18 C 39 18 38 17 38 15 C 38 13 38.5 12 40 12 Z"
            fill="url(#header-stella-grad)"
            mask="url(#header-stella-mask)"
          />
        </svg>

        <span class="text-base font-semibold tracking-tight text-white">
          Stella<span class="text-accent">Labs</span>
        </span>
      </a>
      <Badge />
    </div>

    <!-- Menú de navegación -->
    <nav class="hidden items-center gap-6 text-sm text-gray-400 md:flex">
      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1.5 transition-colors hover:text-white"
        >
          Herramientas
          <svg
            class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>

        <!-- Submenú -->
        <div
          class="invisible absolute left-0 top-full pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100"
        >
          <div class="w-52 rounded-xl border border-white/10 bg-bg/95 p-1.5 shadow-2xl backdrop-blur-lg">
            <a
              href="/eventos"
              class="block rounded-lg px-3 py-2 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
            >
              Registro de eventos
            </a>
            <a
              href="/juegos"
              class="block rounded-lg px-3 py-2 text-sm text-gray-300 transition-colors hover:bg-white/10 hover:text-white"
            >
              Mini juegos
            </a>
          </div>
        </div>
      </div>

      <span class="text-white/15">|</span>
      <a href="/acerca-de" class="transition-colors hover:text-white">Acerca de</a>
      <span class="text-white/15">|</span>
      <a href="/contacto" class="transition-colors hover:text-white">Contacto</a>
    </nav>
  </div>
</header>