---
import Badge from "./Badge.astro";
---

<header
  class="sticky top-0 z-40 w-full border-b border-[var(--color-glass-edge)] bg-[rgba(7,5,15,0.75)] backdrop-blur-xl transition-colors duration-200"
>
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-5 py-3 md:px-8">
    
    <!-- 1. EXTREMO IZQUIERDO: Logo + Marca + Badge -->
    <div class="flex items-center gap-3">
      <a href="/" class="group flex items-center gap-2.5 transition-opacity hover:opacity-90">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 100"
          class="h-6 w-6 shrink-0 transition-transform duration-200 group-hover:scale-105"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="header-stella-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8"></stop>
              <stop offset="100%" stop-color="#1d4ed8"></stop>
            </linearGradient>

            <mask id="header-stella-mask">
              <rect width="100" height="100" fill="white"></rect>
              <path
                d="M 50 49 Q 50 64 65 64 Q 50 64 50 79 Q 50 64 35 64 Q 50 64 50 49 Z"
                fill="black"
              ></path>
            </mask>
          </defs>

          <path
            d="M 40 12 H 60 C 61.5 12 62 13 62 15 C 62 17 61 18 58 18 V 38 L 81.5 76 C 84.5 81 81.5 86 76 86 H 24 C 18.5 86 15.5 81 18.5 76 L 42 38 V 18 C 39 18 38 17 38 15 C 38 13 38.5 12 40 12 Z"
            fill="url(#header-stella-grad)"
            mask="url(#header-stella-mask)"
          ></path>
        </svg>

        <span class="font-sans text-base font-semibold tracking-tight text-white">
          Stella<span class="text-astra-400">Labs</span>
        </span>
      </a>
      <Badge />
    </div>

    <!-- 2. CENTRO-->
    <nav class="hidden items-center gap-7 font-sans text-sm text-[#9da7ba] md:flex">
      <!-- Dropdown Herramientas -->
      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1.5 py-1 text-sm text-[#9da7ba] transition-colors hover:text-white focus:outline-none"
        >
          Herramientas
          <svg
            class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180 text-[#9da7ba] group-hover:text-white"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>

        <div
          class="invisible absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100"
        >
          <div
            class="w-56 rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[rgba(13,10,28,0.96)] p-1.5 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl"
          >
            <a
              href="/eventos"
              class="block rounded-[var(--radius-input,8px)] px-3 py-2 text-sm text-[#9da7ba] transition-all hover:bg-white/5 hover:text-white"
            >
              Registro de eventos
            </a>
            <a
              href="/torneos"
              class="flex items-center justify-between rounded-[var(--radius-input,8px)] px-3 py-2 text-sm text-[#9da7ba] transition-all hover:bg-white/5 hover:text-white"
            >
              <span>Torneos</span>
              <span
                class="rounded-[var(--radius-badge,6px)] border border-cosmic-500/25 bg-cosmic-500/15 px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-cosmic-300"
                >Liga</span
              >
            </a>
            <a
              href="/juegos"
              class="block rounded-[var(--radius-input,8px)] px-3 py-2 text-sm text-[#9da7ba] transition-all hover:bg-white/5 hover:text-white"
            >
              Mini juegos
            </a>
            <a
              href="/guias"
              class="block rounded-[var(--radius-input,8px)] px-3 py-2 text-sm text-[#9da7ba] transition-all hover:bg-white/5 hover:text-white"
            >
              Guías
            </a>
          </div>
        </div>
      </div>

      <span class="h-3 w-px bg-white/10" aria-hidden="true"></span>
      <a href="/acerca-de" class="py-1 transition-colors hover:text-white">
        Acerca de
      </a>
      <span class="h-3 w-px bg-white/10" aria-hidden="true"></span>
      <a href="/contacto" class="py-1 transition-colors hover:text-white">
        Contacto
      </a>
    </nav>

    <!-- 3. EXTREMO DERECHO: Auth Slot & Hamburguesa Móvil -->
    <div class="flex items-center gap-3">
      <!-- SLOT DE AUTENTICACIÓN (DESKTOP) CON ZERO-FLICKER -->
      <div id="auth-slot-desktop" class="relative hidden items-center md:flex min-w-[120px] justify-end">
        <!-- Script inline síncrono: oculta el botón ANTES de pintar en pantalla si hay sesión -->
        <script is:inline>
          (function() {
            try {
              const hasSession = Object.keys(localStorage).some(
                k => k.startsWith('sb-') && k.endsWith('-auth-token') && localStorage.getItem(k)?.includes('access_token')
              );
              if (hasSession) {
                document.write('<style>#btn-login-desktop{display:none !important;}#user-menu-desktop{display:flex !important;}</style>');
              }
            } catch (e) {}
          })();
        </script>

        <!-- Botón de Login -->
        <a
          href="/login"
          id="btn-login-desktop"
          class="inline-flex items-center justify-center rounded-full border border-cosmic-500/25 bg-cosmic-900/30 px-4 py-1.5 font-sans text-sm font-medium text-[#d1e4fa] shadow-[inset_0_1px_1px_rgba(255,255,255,0.08)] backdrop-blur-md transition-all duration-200 hover:border-cosmic-400/50 hover:bg-cosmic-900/60 hover:text-white hover:shadow-[0_0_20px_-3px_rgba(168,85,247,0.25)] focus:outline-none"
        >
          Iniciar sesión
        </a>

        <!-- Contenedor del Avatar -->
        <div id="user-menu-desktop" class="hidden relative items-center">
          <button
            id="avatar-btn-desktop"
            type="button"
            class="flex items-center rounded-full border border-[var(--color-glass-edge)] bg-white/[0.04] p-0.5 transition-all duration-200 hover:border-astra-400/50 hover:shadow-[var(--shadow-glow-astra)] focus:outline-none"
            aria-label="Abrir menú de usuario"
          >
            <img
              id="avatar-img-desktop"
              src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 28 28'%3E%3Crect width='28' height='28' fill='%2316112e'/%3E%3C/svg%3E"
              alt="Avatar de usuario"
              class="h-7 w-7 rounded-full bg-[var(--color-space-800)] object-cover"
            />
          </button>

          <!-- Menú desplegable usuario -->
          <div
            id="user-dropdown"
            class="invisible absolute right-0 top-full mt-2 w-52 rounded-(--radius-card,16px) border border-[var(--color-glass-edge)] bg-[rgba(13,10,28,0.96)] p-1.5 opacity-0 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl transition-all duration-150"
          >
            <div class="border-b border-glass-edge px-3 py-2">
              <p id="user-display-name" class="truncate font-sans text-xs font-semibold text-white"></p>
              <p id="user-display-code" class="truncate font-mono text-[10px] text-[#9da7ba]"></p>
            </div>
            <button
              id="btn-logout-desktop"
              type="button"
              class="mt-1 flex w-full items-center gap-2 rounded-[var(--radius-input,8px)] px-3 py-2 text-left font-sans text-xs font-medium text-rose-400 transition-colors hover:bg-rose-500/10"
            >
              <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Cerrar sesión
            </button>
          </div>
        </div>
      </div>

      <!-- Botón Hamburguesa Móvil -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
        class="inline-flex items-center justify-center rounded-xl border border-[var(--color-glass-edge)] bg-white/[0.03] p-2 text-[#9da7ba] backdrop-blur-md transition-colors hover:border-white/20 hover:text-white md:hidden"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- MENÚ MÓVIL FULLSCREEN SLIDE-OVER DESDE LA DERECHA -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-50 flex h-dvh w-screen translate-x-full flex-col justify-between bg-[rgba(7,5,15,0.98)] p-6 backdrop-blur-2xl transition-transform duration-300 ease-in-out md:hidden"
  aria-hidden="true"
>
  <!-- Cabecera del Drawer -->
  <div>
    <div class="flex items-center justify-between border-b border-[var(--color-glass-edge)] pb-5">
      <div class="flex items-center gap-2.5">
        <span class="font-sans text-lg font-semibold tracking-tight text-white">
          Stella<span class="text-astra-400">Labs</span>
        </span>
        <Badge />
      </div>
      <button
        id="mobile-drawer-close"
        type="button"
        aria-label="Cerrar menú"
        class="rounded-lg border border-[var(--color-glass-edge)] bg-white/[0.03] p-2 text-[#9da7ba] transition-colors hover:border-white/20 hover:text-white"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Sección Auth Móvil -->
    <div class="py-5 border-b border-[var(--color-glass-edge)]">
      <a
        href="/login"
        id="btn-login-mobile"
        class="flex w-full items-center justify-center rounded-full border border-cosmic-500/25 bg-cosmic-900/30 py-2.5 font-sans text-sm font-medium text-[#d1e4fa] shadow-[inset_0_1px_1px_rgba(255,255,255,0.08)] backdrop-blur-md transition-all hover:border-cosmic-400/50 hover:bg-cosmic-900/60 hover:text-white"
      >
        Iniciar sesión
      </a>

      <div id="user-info-mobile" class="hidden items-center justify-between">
        <div class="flex items-center gap-3">
          <img
            id="avatar-img-mobile"
            src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'%3E%3Crect width='36' height='36' fill='%2316112e'/%3E%3C/svg%3E"
            alt="Avatar"
            class="h-9 w-9 rounded-full border border-[var(--color-glass-edge)] bg-[var(--color-space-800)] object-cover"
          />
          <div>
            <p id="user-display-name-mobile" class="font-sans text-sm font-semibold text-white"></p>
            <p id="user-display-code-mobile" class="font-mono text-xs text-[#9da7ba]"></p>
          </div>
        </div>
        <button
          id="btn-logout-mobile"
          type="button"
          class="rounded-[var(--radius-badge,6px)] border border-rose-500/20 bg-rose-500/10 px-3 py-1.5 font-sans text-xs font-medium text-rose-400 transition-colors hover:bg-rose-500/20"
        >
          Cerrar sesión
        </button>
      </div>
    </div>

    <!-- Enlaces Móviles -->
    <div class="pt-6 space-y-6">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.10em] text-[#9da7ba]">Herramientas & Laboratorio</p>
        <div class="mt-3 space-y-2 pl-2">
          <a
            href="/eventos"
            class="flex items-center gap-2.5 rounded-lg py-1.5 text-base text-[#d1e4fa] transition-colors hover:text-white"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-astra-400"></span>
            Registro de eventos
          </a>
          <a
            href="/torneos"
            class="flex items-center justify-between rounded-lg py-1.5 text-base text-[#d1e4fa] transition-colors hover:text-white"
          >
            <div class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-cosmic-400"></span>
              <span>Torneos de videojuegos</span>
            </div>
            <span
              class="rounded-[var(--radius-badge,6px)] border border-cosmic-500/25 bg-cosmic-500/15 px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-cosmic-300"
              >Liga</span
            >
          </a>
          <a
            href="/juegos"
            class="flex items-center gap-2.5 rounded-lg py-1.5 text-base text-[#d1e4fa] transition-colors hover:text-white"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-astra-300"></span>
            Mini juegos
          </a>
          <a
            href="/guias"
            class="flex items-center justify-between rounded-lg py-1.5 text-base text-[#d1e4fa] transition-colors hover:text-white"
          >
            <div class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              <span>Guías</span>
            </div>
            <span
              class="rounded-[var(--radius-badge,6px)] border border-emerald-500/25 bg-emerald-500/15 px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-emerald-400"
              >Docs</span
            >
          </a>
        </div>
      </div>

      <div class="border-t border-[var(--color-glass-edge)] pt-5 space-y-2 font-sans">
        <a href="/acerca-de" class="block py-1.5 text-base font-medium text-[#d1e4fa] transition-colors hover:text-white">
          Acerca de
        </a>
        <a href="/contacto" class="block py-1.5 text-base font-medium text-[#d1e4fa] transition-colors hover:text-white">
          Contacto
        </a>
      </div>
    </div>
  </div>

  <!-- Pie del Drawer -->
  <div class="border-t border-[var(--color-glass-edge)] pt-4 text-center">
    <p class="font-mono text-[11px] text-[#9da7ba]/70">
      Teleinformática • CU Costa Sur
    </p>
  </div>
</div>

<script>
  import { supabase } from "../lib/supabase";

  // --- CONTROL DEL MENÚ MÓVIL ---
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileDrawer = document.getElementById("mobile-drawer");
  const mobileClose = document.getElementById("mobile-drawer-close");

  const openDrawer = () => {
    mobileDrawer?.classList.remove("translate-x-full");
    mobileDrawer?.classList.add("translate-x-0");
    document.body.classList.add("overflow-hidden");
  };

  const closeDrawer = () => {
    mobileDrawer?.classList.add("translate-x-full");
    mobileDrawer?.classList.remove("translate-x-0");
    document.body.classList.remove("overflow-hidden");
  };

  mobileBtn?.addEventListener("click", openDrawer);
  mobileClose?.addEventListener("click", closeDrawer);

  // Cierre garantizado en navegación de cualquier enlace móvil
  mobileDrawer?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeDrawer);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !mobileDrawer?.classList.contains("translate-x-full")) {
      closeDrawer();
    }
  });

  document.addEventListener("astro:before-swap", closeDrawer);
  window.addEventListener("pageshow", closeDrawer);

  // Avatar Lorelei
  const getAvatarUrl = (seed: string) => {
    return `https://api.dicebear.com/9.x/lorelei/svg?seed=${encodeURIComponent(seed)}&backgroundColor=07050f,16112e`;
  };

  // Referencias Auth
  const btnLoginDesktop = document.getElementById("btn-login-desktop");
  const userMenuDesktop = document.getElementById("user-menu-desktop");
  const avatarBtnDesktop = document.getElementById("avatar-btn-desktop");
  const avatarImgDesktop = document.getElementById("avatar-img-desktop") as HTMLImageElement;
  const userDropdown = document.getElementById("user-dropdown");
  const userDisplayName = document.getElementById("user-display-name");
  const userDisplayCode = document.getElementById("user-display-code");
  const btnLogoutDesktop = document.getElementById("btn-logout-desktop");

  const btnLoginMobile = document.getElementById("btn-login-mobile");
  const userInfoMobile = document.getElementById("user-info-mobile");
  const avatarImgMobile = document.getElementById("avatar-img-mobile") as HTMLImageElement;
  const userDisplayNameMobile = document.getElementById("user-display-name-mobile");
  const userDisplayCodeMobile = document.getElementById("user-display-code-mobile");
  const btnLogoutMobile = document.getElementById("btn-logout-mobile");

  // Dropdown Desktop
  avatarBtnDesktop?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isVisible = !userDropdown?.classList.contains("invisible");
    if (isVisible) {
      userDropdown?.classList.add("invisible", "opacity-0");
    } else {
      userDropdown?.classList.remove("invisible", "opacity-0");
    }
  });

  document.addEventListener("click", () => {
    userDropdown?.classList.add("invisible", "opacity-0");
  });

  // Render de estados de autenticación
  const showUserAuth = (user: any) => {
    const meta = user.user_metadata || {};
    const username = meta.username || user.email?.split("@")[0] || "User";
    const studentCode = meta.student_code || "";
    const avatarUrl = getAvatarUrl(username);

    // Desktop
    if (btnLoginDesktop) {
      btnLoginDesktop.classList.add("hidden");
      btnLoginDesktop.classList.remove("inline-flex");
      btnLoginDesktop.style.display = "none";
    }
    if (userMenuDesktop) {
      userMenuDesktop.classList.remove("hidden");
      userMenuDesktop.classList.add("flex");
      userMenuDesktop.style.display = "flex";
    }
    if (avatarImgDesktop) avatarImgDesktop.src = avatarUrl;
    if (userDisplayName) userDisplayName.textContent = `@${username}`;
    if (userDisplayCode) userDisplayCode.textContent = studentCode;

    // Móvil
    if (btnLoginMobile) {
      btnLoginMobile.classList.add("hidden");
      btnLoginMobile.classList.remove("flex");
      btnLoginMobile.style.display = "none";
    }
    if (userInfoMobile) {
      userInfoMobile.classList.remove("hidden");
      userInfoMobile.classList.add("flex");
      userInfoMobile.style.display = "flex";
    }
    if (avatarImgMobile) avatarImgMobile.src = avatarUrl;
    if (userDisplayNameMobile) userDisplayNameMobile.textContent = `@${username}`;
    if (userDisplayCodeMobile) userDisplayCodeMobile.textContent = studentCode;
  };

  const showGuestAuth = () => {
    // Desktop
    if (btnLoginDesktop) {
      btnLoginDesktop.classList.remove("hidden");
      btnLoginDesktop.classList.add("inline-flex");
      btnLoginDesktop.style.display = "";
    }
    if (userMenuDesktop) {
      userMenuDesktop.classList.add("hidden");
      userMenuDesktop.classList.remove("flex");
      userMenuDesktop.style.display = "none";
    }

    // Móvil
    if (btnLoginMobile) {
      btnLoginMobile.classList.remove("hidden");
      btnLoginMobile.classList.add("flex");
      btnLoginMobile.style.display = "";
    }
    if (userInfoMobile) {
      userInfoMobile.classList.add("hidden");
      userInfoMobile.classList.remove("flex");
      userInfoMobile.style.display = "none";
    }
  };

  const syncAuthState = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      showUserAuth(session.user);
    } else {
      showGuestAuth();
    }
  };

  const handleLogout = async () => {
    closeDrawer();
    await supabase.auth.signOut();
    window.location.href = "/";
  };

  btnLogoutDesktop?.addEventListener("click", handleLogout);
  btnLogoutMobile?.addEventListener("click", handleLogout);

  supabase.auth.onAuthStateChange((_event, session) => {
    if (session?.user) {
      showUserAuth(session.user);
    } else {
      showGuestAuth();
    }
  });

  // Ejecución inicial y en transiciones de página
  syncAuthState();
  document.addEventListener("astro:page-load", syncAuthState);
</script>