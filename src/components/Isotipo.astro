---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`isotipo-wrapper flex items-center justify-center ${className}`}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 100 100"
    class="isotipo-svg h-auto w-full drop-shadow-[0_10px_35px_rgba(56,189,248,0.18)]"
    aria-hidden="true"
  >
    <defs>
      <!-- Gradiente principal del matraz -->
      <linearGradient id="hero-stella-grad" x1="15%" y1="0%" x2="85%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8" />
        <stop offset="60%" stop-color="#2563eb" />
        <stop offset="100%" stop-color="#1e3a8a" />
      </linearGradient>

      <!-- Máscara con la estrella centrada ópticamente en (50, 64) -->
      <mask id="hero-stella-mask">
        <rect width="100" height="100" fill="white" />
        <path
          d="M 50 49 Q 50 64 65 64 Q 50 64 50 79 Q 50 64 35 64 Q 50 64 50 49 Z"
          fill="black"
        />
      </mask>

      <!-- Desenfoque para el pulso estelar interno -->
      <filter id="hero-glow-blur" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3.5" result="blur" />
      </filter>
    </defs>

    <!-- Órbita técnica exterior tenue (identidad astronómica / enlaces de red) -->
    <ellipse
      cx="50"
      cy="64"
      rx="44"
      ry="16"
      fill="none"
      stroke="#38bdf8"
      stroke-width="0.8"
      stroke-dasharray="3 3"
      opacity="0.35"
      transform="rotate(-18 50 64)"
    />

    <!-- Glow detrás de la estrella recortada -->
    <circle
      class="isotipo-glow"
      cx="50"
      cy="64"
      r="13"
      fill="#38bdf8"
      filter="url(#hero-glow-blur)"
    />

    <!-- Cuerpo del matraz estilizado con esquinas redondeadas -->
    <path
      d="M 40 12 H 60 C 61.5 12 62 13 62 15 C 62 17 61 18 58 18 V 38 L 81.5 76 C 84.5 81 81.5 86 76 86 H 24 C 18.5 86 15.5 81 18.5 76 L 42 38 V 18 C 39 18 38 17 38 15 C 38 13 38.5 12 40 12 Z"
      fill="url(#hero-stella-grad)"
      mask="url(#hero-stella-mask)"
    />
  </svg>
</div>

<style>
  .isotipo-svg {
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .isotipo-glow {
    transform-origin: 50px 64px;
    opacity: 0.45;
    animation: isotipo-pulse 3.5s ease-in-out infinite;
  }

  @keyframes isotipo-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.92);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.15);
    }
  }

  .isotipo-wrapper:hover .isotipo-svg {
    transform: translateY(-4px) scale(1.02);
  }

  .isotipo-wrapper:hover .isotipo-glow {
    opacity: 0.9;
    animation-duration: 1.5s;
  }

  @media (prefers-reduced-motion: reduce) {
    .isotipo-glow {
      animation: none;
      opacity: 0.5;
    }
    .isotipo-svg {
      transition: none;
    }
  }
</style>