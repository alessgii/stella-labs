---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";

const paper = [
  "Una fila en la puerta mientras cada quien escribe sus datos",
  "Letra difícil de leer y códigos mal anotados",
  "Nombres repetidos o faltantes que alguien corrige después",
  "Pasar todo a Excel antes de poder hacer las constancias",
];

const stella = [
  "Pasas la credencial por el lector, o tecleas tu código, y sigues",
  "El código se guarda tal cual, sin errores de letra",
  "Si ya te habías registrado, el sistema lo detecta",
  "Las asistencias quedan listas para generar constancias",
];

const steps = [
  { n: "01", title: "Un equipo en la entrada", text: "El personal abre el registro de la conferencia desde un equipo fijo en el salón." },
  { n: "02", title: "Pasas tu credencial", text: "O escribes tu código de alumno. Si no tienes cuenta en la plataforma, el código basta." },
  { n: "03", title: "Siguiente", text: "Queda guardado al instante y la persona de atrás ya puede registrarse." },
];
---

<Layout title="Acceso denegado | StellaLabs">
  <Header />

  <main class="relative overflow-hidden px-6 pb-20 pt-6 md:px-10">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(56,189,248,0.06)_1px,transparent_1px)] [background-size:32px_32px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-4xl">
      <div
        class="flex flex-col gap-3 rounded-card border border-rose-400/25 bg-rose-400/[0.06] px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
        role="alert"
      >
        <div class="flex items-start gap-3">
          <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-rose-400/30 bg-rose-400/10 text-rose-300">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="11" width="16" height="10" rx="2"></rect>
              <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="font-sans text-sm font-medium text-white">
              Acceso denegado
              <span class="font-normal text-[#9da7ba]">· Esta herramienta es solo para el equipo del evento.</span>
            </p>
            <p id="reason" class="mt-0.5 font-sans text-xs leading-relaxed text-rose-200/70">
              Requiere privilegios de administrador u organizador.
            </p>
          </div>
        </div>

        <a
          id="login-btn"
          href="/login"
          hidden
          class="inline-flex shrink-0 items-center justify-center rounded-pill bg-astra-500 px-4 py-2 font-mono text-xs font-medium tracking-wider text-space-950 transition hover:bg-astra-400"
        >
          Iniciar sesión
        </a>
      </div>

      <section class="mt-12 text-center md:mt-16">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-astra-400/20 bg-astra-400/10 px-3.5 py-1 font-mono text-xs tracking-[0.10em] text-astra-300">
          <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"></span>
          SISTEMA DE ASISTENCIAS
        </div>
        <h1 class="mx-auto max-w-2xl text-balance font-sans text-3xl font-medium tracking-tight text-white sm:text-4xl md:text-5xl md:leading-[1.1]">
          Registrar asistencia <span class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent">sin filas ni hojas</span>
        </h1>
        <p class="mx-auto mt-4 max-w-xl font-sans text-base leading-relaxed text-[#9da7ba] md:text-lg">
          Un equipo en la entrada de la conferencia, tu credencial al lector y listo. Lo programamos estudiantes de Teleinformática en el CUCSur para dejar de pasar una hoja de mano en mano.
        </p>
      </section>

      <ol class="mt-10 grid grid-cols-1 gap-3 md:grid-cols-3">
        {
          steps.map((s) => (
            <li class="rounded-card border border-glass-edge bg-glass-surface px-5 py-4 shadow-glass-card backdrop-blur-md">
              <span class="font-mono text-xs font-medium tracking-widest text-astra-400">{s.n}</span>
              <h2 class="mt-1.5 font-sans text-base font-medium text-white">{s.title}</h2>
              <p class="mt-1 font-sans text-sm leading-relaxed text-[#9da7ba]">{s.text}</p>
            </li>
          ))
        }
      </ol>

      <section class="mt-10" aria-label="Hoja de papel contra StellaLabs">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="rounded-card border border-glass-edge bg-white/[0.02] p-5 sm:p-6">
            <p class="font-mono text-xs tracking-widest text-[#9da7ba]">CON UNA HOJA DE PAPEL</p>
            <ul class="mt-4 space-y-3">
              {
                paper.map((t) => (
                  <li class="flex items-start gap-3 font-sans text-sm leading-relaxed text-[#9da7ba]">
                    <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-rose-400/10 text-[11px] text-rose-300" aria-hidden="true">✕</span>
                    <span>{t}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-card border border-astra-400/30 bg-astra-400/[0.06] p-5 shadow-glow-astra sm:p-6">
            <p class="font-mono text-xs tracking-widest text-astra-300">CON STELLALABS</p>
            <ul class="mt-4 space-y-3">
              {
                stella.map((t) => (
                  <li class="flex items-start gap-3 font-sans text-sm leading-relaxed text-white">
                    <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-emerald-400/15 text-[11px] text-emerald-400" aria-hidden="true">✓</span>
                    <span>{t}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="mt-6 flex justify-center">
          <a
            href="/acerca-de"
            class="group inline-flex items-center gap-2 font-mono text-xs font-medium tracking-wider text-astra-400 transition-colors hover:text-white"
          >
            Conocer más sobre StellaLabs
            <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="mt-14 rounded-modal border border-glass-edge bg-glass-surface p-8 text-center shadow-glass-card backdrop-blur-xl sm:p-10">
        <h2 class="font-sans text-xl font-medium text-white sm:text-2xl">
          ¿Crees que se necesita una versión para estudiantes y maestros?
        </h2>
        <p class="mx-auto mt-2 max-w-md font-sans text-sm text-[#9da7ba] sm:text-base">
          Cuéntanos qué te serviría y lo revisamos.
        </p>
        <div class="mt-6 flex justify-center">
          <Button href="/sugerencias" variant="primary">Envíanos tu propuesta</Button>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // ?motivo=sesion -> no hay sesión o ?motivo=rol -> hay sesión pero sin permisos
  const motivo = new URLSearchParams(window.location.search).get("motivo");
  const reason = document.getElementById("reason");
  const login = document.getElementById("login-btn") as HTMLAnchorElement | null;

  if (motivo === "sesion" && reason && login) {
    reason.textContent = "Inicia sesión con una cuenta de administrador u organizador.";
    login.hidden = false;
    login.href = "/login?redirect=/eventos/asistencia";
  } else if (motivo === "rol" && reason) {
    reason.textContent = "Tu cuenta no tiene privilegios de administrador u organizador.";
  }
</script>