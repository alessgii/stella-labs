---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Crear Cuenta | StellaLabs">
  <Header />

  <main class="relative flex min-h-[calc(100vh-5rem)] items-center justify-center px-4 py-16 md:px-10">
    <!-- Luces ambientales de fondo (Astra + Cosmic) -->
    <div
      class="pointer-events-none absolute -left-28 top-1/3 h-[420px] w-[420px] rounded-full bg-cosmic-500/10 blur-[150px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-28 bottom-1/3 h-[420px] w-[420px] rounded-full bg-astra-500/10 blur-[150px]"
      aria-hidden="true"
    ></div>

    <!-- Tarjeta de cristal para Registro -->
    <div
      class="relative z-10 w-full max-w-lg rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[rgba(13,10,28,0.75)] p-6 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl sm:p-8"
    >
      <!-- Cabecera del formulario -->
      <div class="mb-7 text-center">
        <div
          class="mb-3.5 inline-flex items-center gap-2 rounded-full border border-cosmic-400/20 bg-cosmic-400/10 px-3.5 py-1 font-mono text-[11px] tracking-wider text-cosmic-300 backdrop-blur-md"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-cosmic-400 shadow-[0_0_8px_#c084fc]"></span>
          NUEVO REGISTRO // LAB_ID
        </div>
        <h1 class="font-sans text-2xl font-medium tracking-tight text-white sm:text-3xl">
          Únete a StellaLabs
        </h1>
        <p class="mt-2 text-xs text-[#9da7ba] sm:text-sm">
          Crea tu perfil para inscribirte en talleres y torneos con un solo clic.
        </p>
      </div>

      <form id="registro-form" class="space-y-4">
        <!-- Código de estudiante -->
        <div>
          <label for="student_code" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
            Código de estudiante (UDG)
          </label>
          <input
            type="text"
            id="student_code"
            name="student_code"
            required
            placeholder="219876543"
            class="w-full rounded-[var(--radius-input,8px)] border border-[var(--color-glass-edge)] bg-[rgba(7,5,15,0.6)] px-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/40 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/40"
          />
        </div>

        <!-- Nombre y Apellido (2 columnas) -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="first_name" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
              Nombre(s)
            </label>
            <input
              type="text"
              id="first_name"
              name="first_name"
              required
              placeholder="Stella"
              class="w-full rounded-[var(--radius-input,8px)] border border-[var(--color-glass-edge)] bg-[rgba(7,5,15,0.6)] px-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/40 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/40"
            />
          </div>
          <div>
            <label for="last_name" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
              Apellido(s)
            </label>
            <input
              type="text"
              id="last_name"
              name="last_name"
              required
              placeholder="Labs"
              class="w-full rounded-[var(--radius-input,8px)] border border-[var(--color-glass-edge)] bg-[rgba(7,5,15,0.6)] px-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/40 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/40"
            />
          </div>
        </div>

        <!-- Username -->
        <div>
          <label for="username" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
            Nombre de usuario (Alias)
          </label>
          <input
            type="text"
            id="username"
            name="username"
            required
            placeholder="stella66"
            class="w-full rounded-[var(--radius-input,8px)] border border-[var(--color-glass-edge)] bg-[rgba(7,5,15,0.6)] px-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/40 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/40"
          />
        </div>

        <!-- Correo electrónico -->
        <div>
          <label for="email" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
            Correo electrónico
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="stella.labs66@alumnos.udg.mx"
            class="w-full rounded-[var(--radius-input,8px)] border border-[var(--color-glass-edge)] bg-[rgba(7,5,15,0.6)] px-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/40 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/40"
          />
        </div>

        <!-- Contraseña -->
        <div>
          <label for="password" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
            Contraseña (Mínimo 6 caracteres)
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            placeholder="••••••••"
            class="w-full rounded-[var(--radius-input,8px)] border border-[var(--color-glass-edge)] bg-[rgba(7,5,15,0.6)] px-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/40 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/40"
          />
        </div>

        <!-- Botón de acción con estilo píldora dual -->
        <button
          type="submit"
          id="btn-submit"
          class="mt-3 flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-astra-500 to-cosmic-600 py-2.5 font-sans text-sm font-medium tracking-wide text-white shadow-[0_0_25px_-5px_rgba(56,189,248,0.35)] transition-all duration-200 hover:from-astra-400 hover:to-cosmic-500 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60"
        >
          <span id="btn-submit-spinner" class="hidden h-3.5 w-3.5 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
          <span id="btn-submit-text">Crear mi cuenta</span>
        </button>

        <!-- Pie de tarjeta -->
        <p class="pt-2 text-center font-sans text-xs text-[#9da7ba]">
          ¿Ya tienes cuenta?
          <a href="/login" class="text-astra-400 underline underline-offset-4 transition-colors hover:text-white">
            Inicia sesión
          </a>
        </p>
      </form>
    </div>
  </main>

  <!-- MODAL GLASS UNIVERSAL PARA REGISTRO (ÉXITO / ERROR) -->
  <div
    id="registro-glass-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
  >
    <div id="registro-modal-backdrop" class="fixed inset-0 bg-[var(--color-space-950)]/80 backdrop-blur-md"></div>
    <div
      class="relative z-10 w-full max-w-sm rounded-[var(--radius-modal,20px)] border border-[var(--color-glass-edge)] bg-[rgba(13,10,28,0.92)] p-6 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl transition-all"
    >
      <div id="modal-icon-wrapper" class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border">
        <!-- SVG inyectado dinámicamente -->
      </div>
      <h3 id="modal-title" class="text-center font-sans text-base font-medium text-white"></h3>
      <div id="modal-desc" class="mt-2 text-center font-sans text-xs leading-relaxed text-[#9da7ba]"></div>

      <div id="modal-actions" class="mt-6 flex flex-col gap-2">
        <!-- Botones inyectados dinámicamente -->
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { supabase } from "../lib/supabase";

  const form = document.getElementById("registro-form") as HTMLFormElement;
  const btn = document.getElementById("btn-submit") as HTMLButtonElement;
  const btnText = document.getElementById("btn-submit-text") as HTMLSpanElement;
  const btnSpinner = document.getElementById("btn-submit-spinner") as HTMLSpanElement;

  const modal = document.getElementById("registro-glass-modal") as HTMLDivElement;
  const modalBackdrop = document.getElementById("registro-modal-backdrop") as HTMLDivElement;
  const iconWrapper = document.getElementById("modal-icon-wrapper") as HTMLDivElement;
  const modalTitle = document.getElementById("modal-title") as HTMLHeadingElement;
  const modalDesc = document.getElementById("modal-desc") as HTMLDivElement;
  const modalActions = document.getElementById("modal-actions") as HTMLDivElement;

  const showGlassModal = (options: {
    type: "error" | "exito";
    title: string;
    description: string;
    actionText?: string;
    actionHref?: string;
  }) => {
    modalTitle.textContent = options.title;
    modalDesc.innerHTML = options.description;

    if (options.type === "error") {
      iconWrapper.className =
        "mx-auto mb-4 flex h-11 w-11 items-center justify-center rounded-full border border-rose-500/30 bg-rose-500/10 text-rose-400";
      iconWrapper.innerHTML = `
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      `;

      if (options.actionHref) {
        modalActions.innerHTML = `
          <a href="${options.actionHref}" class="w-full text-center rounded-full bg-gradient-to-r from-astra-500 to-cosmic-600 py-2 font-sans text-xs font-medium text-white transition-all hover:opacity-90">
            ${options.actionText || "Continuar"}
          </a>
          <button type="button" id="btn-close-modal" class="w-full rounded-full border border-[var(--color-glass-edge)] bg-white/[0.04] py-2 font-sans text-xs font-medium text-[#9da7ba] transition-all hover:text-white">
            Cerrar
          </button>
        `;
      } else {
        modalActions.innerHTML = `
          <button type="button" id="btn-close-modal" class="w-full rounded-full border border-[var(--color-glass-edge)] bg-white/[0.05] py-2 font-sans text-xs font-medium text-white transition-all hover:bg-white/[0.10]">
            Entendido
          </button>
        `;
      }
    } else {
      iconWrapper.className =
        "mx-auto mb-4 flex h-11 w-11 items-center justify-center rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400";
      iconWrapper.innerHTML = `
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      `;
      modalActions.innerHTML = `
        <p class="text-center font-mono text-[11px] text-emerald-400">Redirigiendo a inicio de sesión...</p>
      `;
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    document.getElementById("btn-close-modal")?.addEventListener("click", closeModal);
  };

  const closeModal = () => {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  };

  modalBackdrop?.addEventListener("click", closeModal);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btnSpinner.classList.remove("hidden");
    btnText.innerText = "Verificando...";

    const formData = new FormData(form);
    const email = String(formData.get("email")).trim().toLowerCase();
    const password = String(formData.get("password"));
    const student_code = String(formData.get("student_code")).trim();
    const first_name = String(formData.get("first_name")).trim();
    const last_name = String(formData.get("last_name")).trim();
    const username = String(formData.get("username")).trim().toLowerCase();

    try {
      // 1. Verificación en base de datos
      const { data: checks, error: rpcError } = await supabase.rpc("check_user_exists", {
        p_username: username,
        p_student_code: student_code,
      });

      if (rpcError) {
        throw new Error("No se pudo verificar la disponibilidad del usuario o código.");
      }

      if (checks?.username_exists) {
        showGlassModal({
          type: "error",
          title: "Alias no disponible",
          description: "El nombre de usuario ingresado ya está en uso. Por favor elige otro.",
        });
        btn.disabled = false;
        btnSpinner.classList.add("hidden");
        btnText.innerText = "Crear mi cuenta";
        return;
      }

      if (checks?.code_exists) {
        showGlassModal({
          type: "error",
          title: "Código ya registrado",
          description: "Este código de estudiante ya cuenta con un perfil asociado en StellaLabs.",
          actionText: "Ir a Iniciar Sesión",
          actionHref: "/login",
        });
        btn.disabled = false;
        btnSpinner.classList.add("hidden");
        btnText.innerText = "Crear mi cuenta";
        return;
      }

      btnText.innerText = "Creando cuenta...";

      // 2. Registro en Supabase
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: {
            student_code,
            first_name,
            last_name,
            username,
            career: "Ingeniería en Teleinformática",
          },
        },
      });

      if (error) {
        const msg = error.message.toLowerCase();
        if (
          msg.includes("already registered") ||
          msg.includes("already in use") ||
          msg.includes("unique constraint") ||
          msg.includes("user already exists")
        ) {
          showGlassModal({
            type: "error",
            title: "Correo en uso",
            description: "Este correo electrónico ya está registrado en la plataforma.",
            actionText: "Iniciar Sesión",
            actionHref: "/login",
          });
          btn.disabled = false;
          btnSpinner.classList.add("hidden");
          btnText.innerText = "Crear mi cuenta";
          return;
        }
        throw error;
      }

      if (data?.user && Array.isArray(data.user.identities) && data.user.identities.length === 0) {
        showGlassModal({
          type: "error",
          title: "Correo ya existente",
          description: "Ya existe una cuenta vinculada a este correo.",
          actionText: "Iniciar Sesión",
          actionHref: "/login",
        });
        btn.disabled = false;
        btnSpinner.classList.add("hidden");
        btnText.innerText = "Crear mi cuenta";
        return;
      }

      // 3. Éxito
      showGlassModal({
        type: "exito",
        title: "¡Cuenta creada con éxito!",
        description: "Recibirás un correo para verificar tu cuenta.",
      });

      form.reset();

      setTimeout(() => {
        window.location.href = "/login";
      }, 3000);
    } catch (err: any) {
      btn.disabled = false;
      btnSpinner.classList.add("hidden");
      btnText.innerText = "Crear mi cuenta";

      showGlassModal({
        type: "error",
        title: "Error inesperado",
        description: err.message || "Ocurrió un problema al registrar la cuenta. Inténtalo de nuevo.",
      });
    }
  });
</script>