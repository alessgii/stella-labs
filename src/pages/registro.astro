---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Crear Cuenta | StellaLabs">
  <Header/>

  <main class="relative flex min-h-[calc(100vh-5rem)] items-center justify-center px-4 py-16 md:px-10 overflow-x-hidden">
    <!-- Luces ambientales de fondo -->
    <div
      class="pointer-events-none absolute -left-28 top-1/3 h-[420px] w-[420px] rounded-full bg-cosmic-500/10 blur-[150px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-28 bottom-1/3 h-[420px] w-[420px] rounded-full bg-astra-500/10 blur-[150px]"
      aria-hidden="true"
    ></div>

    <!-- Tarjeta Glassmorphism de Registro -->
    <div
      class="relative z-10 w-full max-w-xl rounded-[var(--radius-card,16px)] border border-white/10 bg-[rgba(13,10,28,0.85)] p-6 sm:p-9 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl"
    >
      <!-- Cabecera técnica -->
      <div class="mb-8 text-center">
        <div
          class="mb-3 inline-flex items-center gap-2 rounded-full border border-cosmic-400/25 bg-cosmic-500/10 px-3.5 py-1 font-mono text-[11px] font-medium tracking-wider text-cosmic-300 backdrop-blur-md"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-cosmic-400 shadow-[0_0_8px_#c084fc] animate-pulse"></span>
          LAB_ACCESS // ALTA DE USUARIO
        </div>
        <h1 class="font-sans text-2xl font-semibold tracking-tight text-white sm:text-3xl">
          Crea tu perfil de investigación
        </h1>
        <p class="mt-2 text-xs text-[#9da7ba] sm:text-sm">
          Participa en talleres, hackathones y proyectos del laboratorio de teleinformática.
        </p>
      </div>

      <form id="registro-form" class="space-y-6">
        <!-- SECCIÓN 1: Identidad Estudiantil -->
        <div class="space-y-3.5">
          <div class="flex items-center gap-2 border-b border-white/[0.06] pb-1.5">
            <span class="font-mono text-[11px] font-semibold tracking-wider text-astra-400 uppercase">
              // 01. Identidad Estudiantil
            </span>
          </div>

          <!-- Código UDG -->
          <div>
            <label for="student_code" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
              Código de estudiante UDG
            </label>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-[#9da7ba]/60">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
                </svg>
              </div>
              <input
                type="text"
                id="student_code"
                name="student_code"
                required
                maxlength="9"
                pattern="[0-9]+"
                placeholder="219876543"
                class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 pl-10 pr-3.5 py-2.5 font-mono text-sm text-white placeholder-[#9da7ba]/30 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/50 focus:shadow-[var(--shadow-glow-astra)]"
              />
            </div>
          </div>

          <!-- Nombre y Apellidos (2 columnas) -->
          <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
            <div>
              <label for="first_name" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
                Nombre(s)
              </label>
              <input
                type="text"
                id="first_name"
                name="first_name"
                required
                placeholder="Ej. Stella"
                class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/30 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/50"
              />
            </div>
            <div>
              <label for="last_name" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
                Apellido(s)
              </label>
              <input
                type="text"
                id="last_name"
                name="last_name"
                required
                placeholder="Ej. Labs"
                class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/30 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/50"
              />
            </div>
          </div>

          <!-- Alias / Username -->
          <div>
            <label for="username" class="block font-mono text-xs text-[#9da7ba] mb-1.5 flex justify-between">
              <span>Nombre de usuario</span>
              <span class="text-[#9da7ba]/60 text-[10px]">Visible en torneos y perfil</span>
            </label>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 font-mono text-sm text-astra-400">@</span>
              <input
                type="text"
                id="username"
                name="username"
                required
                placeholder="stella66"
                class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 pl-8 pr-3.5 py-2.5 font-mono text-sm text-white placeholder-[#9da7ba]/30 backdrop-blur-sm transition-all focus:border-astra-400 focus:outline-none focus:ring-1 focus:ring-astra-400/50"
              />
            </div>
          </div>
        </div>

        <!-- SECCIÓN 2: Acceso y Credenciales -->
        <div class="space-y-3.5 pt-1">
          <div class="flex items-center gap-2 border-b border-white/[0.06] pb-1.5">
            <span class="font-mono text-[11px] font-semibold tracking-wider text-cosmic-400 uppercase">
              // 02. Credenciales y Acceso
            </span>
          </div>

          <!-- Correo institucional / personal -->
          <div>
            <label for="email" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
              Correo electrónico
            </label>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-[#9da7ba]/60">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                </svg>
              </div>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu.nombre@alumnos.udg.mx"
                class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 pl-10 pr-3.5 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/30 backdrop-blur-sm transition-all focus:border-cosmic-400 focus:outline-none focus:ring-1 focus:ring-cosmic-400/50"
              />
            </div>
          </div>

          <!-- Contraseña con Mostrar/Ocultar -->
          <div>
            <label for="password" class="block font-mono text-xs text-[#9da7ba] mb-1.5">
              Contraseña
            </label>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-[#9da7ba]/60">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="6"
                placeholder="••••••••••••"
                class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 pl-10 pr-10 py-2.5 font-sans text-sm text-white placeholder-[#9da7ba]/30 backdrop-blur-sm transition-all focus:border-cosmic-400 focus:outline-none focus:ring-1 focus:ring-cosmic-400/50"
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Mostrar u ocultar contraseña"
                class="absolute inset-y-0 right-0 flex items-center pr-3 text-[#9da7ba]/70 hover:text-white transition-colors focus:outline-none"
              >
                <!-- Icono Ojo -->
                <svg id="eye-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
            <!-- Feedback de longitud -->
            <div class="mt-1.5 flex items-center gap-1.5 font-mono text-[11px] text-[#9da7ba]/70" id="password-hint">
              <span id="pwd-check-dot" class="h-1.5 w-1.5 rounded-full bg-slate-500"></span>
              <span>Mínimo 6 caracteres</span>
            </div>
          </div>
        </div>

        <!-- Botón de Envío -->
        <button
          type="submit"
          id="btn-submit"
          class="relative mt-2 flex w-full items-center justify-center gap-2 overflow-hidden rounded-full bg-gradient-to-r from-astra-500 via-astra-600 to-cosmic-600 py-3 font-sans text-sm font-semibold tracking-wide text-white shadow-[0_0_25px_-5px_rgba(56,189,248,0.4)] transition-all duration-200 hover:shadow-[0_0_30px_-2px_rgba(168,85,247,0.5)] hover:brightness-110 active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span id="btn-submit-spinner" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
          <span id="btn-submit-text">Completar Registro</span>
        </button>

        <!-- Pie del Formulario -->
        <p class="text-center font-sans text-xs text-[#9da7ba]">
          ¿Ya tienes cuenta activa?
          <a href="/login" class="font-medium text-astra-400 hover:text-astra-300 underline underline-offset-4 transition-colors">
            Inicia sesión aquí
          </a>
        </p>
      </form>
    </div>
  </main>

  <!-- MODAL GLASS (ÉXITO / VERIFICACIÓN / ERROR) -->
  <div
    id="registro-glass-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
  >
    <div id="registro-modal-backdrop" class="fixed inset-0 bg-space-950/85 backdrop-blur-md"></div>
    <div
      class="relative z-10 w-full max-w-md rounded-[var(--radius-modal,20px)] border border-white/10 bg-[rgba(13,10,28,0.95)] p-6 sm:p-7 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl"
    >
      <div id="modal-icon-wrapper" class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border">
        <!-- Icono dinámico -->
      </div>

      <h3 id="modal-title" class="text-center font-sans text-lg font-semibold text-white"></h3>
      
      <div id="modal-desc" class="mt-2.5 text-center font-sans text-xs leading-relaxed text-[#9da7ba]"></div>

      <div id="modal-actions" class="mt-6 flex flex-col gap-2.5">
        <!-- Acciones dinámicas -->
      </div>
    </div>
  </div>

  <Footer/>
</Layout>

<script>
  import { supabase } from "../lib/supabase";

  const form = document.getElementById("registro-form") as HTMLFormElement;
  const btn = document.getElementById("btn-submit") as HTMLButtonElement;
  const btnText = document.getElementById("btn-submit-text") as HTMLSpanElement;
  const btnSpinner = document.getElementById("btn-submit-spinner") as HTMLSpanElement;

  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const togglePasswordBtn = document.getElementById("toggle-password") as HTMLButtonElement;
  const pwdCheckDot = document.getElementById("pwd-check-dot") as HTMLSpanElement;

  const modal = document.getElementById("registro-glass-modal") as HTMLDivElement;
  const modalBackdrop = document.getElementById("registro-modal-backdrop") as HTMLDivElement;
  const iconWrapper = document.getElementById("modal-icon-wrapper") as HTMLDivElement;
  const modalTitle = document.getElementById("modal-title") as HTMLHeadingElement;
  const modalDesc = document.getElementById("modal-desc") as HTMLDivElement;
  const modalActions = document.getElementById("modal-actions") as HTMLDivElement;

  // Toggle de visibilidad de contraseña
  togglePasswordBtn?.addEventListener("click", () => {
    const isPassword = passwordInput.getAttribute("type") === "password";
    passwordInput.setAttribute("type", isPassword ? "text" : "password");
    togglePasswordBtn.classList.toggle("text-astra-400", isPassword);
  });

  // Indicador dinámico de contraseña mínima
  passwordInput?.addEventListener("input", () => {
    if (passwordInput.value.length >= 6) {
      pwdCheckDot.className = "h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_#34d399]";
    } else {
      pwdCheckDot.className = "h-1.5 w-1.5 rounded-full bg-slate-500";
    }
  });

  const showGlassModal = (options: {
    type: "error" | "verificacion";
    title: string;
    description: string;
    emailTarget?: string;
    actionText?: string;
    actionHref?: string;
  }) => {
    modalTitle.textContent = options.title;

    if (options.type === "error") {
      iconWrapper.className =
        "mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-rose-500/30 bg-rose-500/10 text-rose-400 shadow-[0_0_20px_rgba(244,63,94,0.2)]";
      iconWrapper.innerHTML = `
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      `;

      modalDesc.innerHTML = `<p class="text-[#9da7ba]">${options.description}</p>`;

      if (options.actionHref) {
        modalActions.innerHTML = `
          <a href="${options.actionHref}" class="w-full text-center rounded-full bg-gradient-to-r from-astra-500 to-cosmic-600 py-2.5 font-sans text-xs font-semibold text-white transition-all hover:opacity-95 shadow-md">
            ${options.actionText || "Continuar"}
          </a>
          <button type="button" id="btn-close-modal" class="w-full rounded-full border border-white/10 bg-white/[0.04] py-2 font-sans text-xs font-medium text-[#9da7ba] transition-all hover:text-white">
            Cerrar
          </button>
        `;
      } else {
        modalActions.innerHTML = `
          <button type="button" id="btn-close-modal" class="w-full rounded-full border border-white/10 bg-white/[0.06] py-2.5 font-sans text-xs font-semibold text-white transition-all hover:bg-white/[0.12]">
            Entendido
          </button>
        `;
      }
    } else {
      iconWrapper.className =
        "mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-astra-400/40 bg-astra-500/15 text-astra-300 shadow-[var(--shadow-glow-astra)] animate-pulse";
      iconWrapper.innerHTML = `
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      `;

      modalDesc.innerHTML = `
        <div class="space-y-3">
          <p class="text-sm text-white">
            Hemos enviado un enlace de confirmación a:
          </p>
          <div class="rounded-lg border border-astra-400/25 bg-astra-400/10 py-1.5 px-3 font-mono text-xs font-semibold text-astra-300 break-all select-all">
            ${options.emailTarget}
          </div>
          <div class="rounded-lg border border-amber-500/20 bg-amber-500/10 p-2.5 text-left text-[11px] leading-relaxed text-amber-200/90">
            <span class="font-bold">⚠️ Importante:</span> Debes presionar el enlace en tu correo antes de poder ingresar. Si no lo encuentras en 1 minuto, revisa tu carpeta de <strong>Spam o Correo no deseado</strong>.
          </div>
        </div>
      `;

      modalActions.innerHTML = `
        <a href="/login" class="w-full text-center rounded-full bg-gradient-to-r from-astra-500 to-cosmic-600 py-2.5 font-sans text-xs font-semibold text-white transition-all hover:opacity-95 shadow-[var(--shadow-glow-astra)]">
          Ir a Iniciar Sesión
        </a>
        <button type="button" id="btn-close-modal" class="w-full rounded-full border border-white/10 bg-white/[0.04] py-2 font-mono text-[11px] text-[#9da7ba] transition-all hover:text-white">
          Permanecer aquí
        </button>
      `;
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    document.getElementById("btn-close-modal")?.addEventListener("click", closeModal);
  };

  const closeModal = () => {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  };

  modalBackdrop?.addEventListener("click", closeModal);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btnSpinner.classList.remove("hidden");
    btnText.innerText = "Verificando disponibilidad...";

    const formData = new FormData(form);
    const email = String(formData.get("email")).trim().toLowerCase();
    const password = String(formData.get("password"));
    const student_code = String(formData.get("student_code")).trim();
    const first_name = String(formData.get("first_name")).trim();
    const last_name = String(formData.get("last_name")).trim();
    const username = String(formData.get("username")).trim().toLowerCase();

    try {
      // 1. Verificación previa en BD
      const { data: checks, error: rpcError } = await supabase.rpc("check_user_exists", {
        p_username: username,
        p_student_code: student_code,
      });

      if (rpcError) {
        throw new Error("No se pudo verificar la disponibilidad del usuario o código.");
      }

      if (checks?.username_exists) {
        showGlassModal({
          type: "error",
          title: "Alias no disponible",
          description: "El nombre de usuario ingresado ya está en uso. Por favor elige otro.",
        });
        btn.disabled = false;
        btnSpinner.classList.add("hidden");
        btnText.innerText = "Completar Registro";
        return;
      }

      if (checks?.code_exists) {
        showGlassModal({
          type: "error",
          title: "Código ya registrado",
          description: "Este código de estudiante ya cuenta con un perfil asociado en StellaLabs.",
          actionText: "Ir a Iniciar Sesión",
          actionHref: "/login",
        });
        btn.disabled = false;
        btnSpinner.classList.add("hidden");
        btnText.innerText = "Completar Registro";
        return;
      }

      btnText.innerText = "Generando credenciales...";

      // 2. Registro en Supabase Auth
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: {
            student_code,
            first_name,
            last_name,
            username,
            career: "Ingeniería en Teleinformática",
          },
        },
      });

      if (error) {
        const msg = error.message.toLowerCase();
        if (
          msg.includes("already registered") ||
          msg.includes("already in use") ||
          msg.includes("unique constraint") ||
          msg.includes("user already exists")
        ) {
          showGlassModal({
            type: "error",
            title: "Correo ya registrado",
            description: "Este correo electrónico ya cuenta con una cuenta registrada en la plataforma.",
            actionText: "Iniciar Sesión",
            actionHref: "/login",
          });
          btn.disabled = false;
          btnSpinner.classList.add("hidden");
          btnText.innerText = "Completar Registro";
          return;
        }
        throw error;
      }

      if (data?.user && Array.isArray(data.user.identities) && data.user.identities.length === 0) {
        showGlassModal({
          type: "error",
          title: "Correo existente",
          description: "Ya existe una cuenta vinculada a este correo.",
          actionText: "Iniciar Sesión",
          actionHref: "/login",
        });
        btn.disabled = false;
        btnSpinner.classList.add("hidden");
        btnText.innerText = "Completar Registro";
        return;
      }

      // 3. Éxito: Mostrar modal claro de verificación por correo
      showGlassModal({
        type: "verificacion",
        title: "¡Verifica tu correo!",
        description: "",
        emailTarget: email,
      });

      form.reset();
      pwdCheckDot.className = "h-1.5 w-1.5 rounded-full bg-slate-500";
      btn.disabled = false;
      btnSpinner.classList.add("hidden");
      btnText.innerText = "Completar Registro";

    } catch (err: any) {
      btn.disabled = false;
      btnSpinner.classList.add("hidden");
      btnText.innerText = "Completar Registro";

      showGlassModal({
        type: "error",
        title: "Error en el registro",
        description: err.message || "Ocurrió un problema al procesar el alta. Por favor intenta nuevamente.",
      });
    }
  });
</script>