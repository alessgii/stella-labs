---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="StellaLabs — Acerca de">
  <Header />

  <main class="relative min-h-[calc(100vh-14rem)] overflow-hidden px-6 py-16 md:px-10 lg:py-24">
    <!-- Luces y atmósfera ambiental -->
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(#38bdf810_1px,transparent_1px)] [background-size:28px_28px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -top-24 right-1/4 h-[380px] w-[380px] rounded-full bg-astra-400/10 blur-[130px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute bottom-10 -left-20 h-[360px] w-[360px] rounded-full bg-cosmic-500/10 blur-[140px]"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-5xl">
      <!-- Encabezado principal -->
      <div class="text-center sm:text-left">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-astra-400/20 bg-astra-400/10 px-3.5 py-1 text-xs font-mono text-astra-400">
          <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"></span>
          LABORATORIO EXPERIMENTAL
        </div>

        <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl">
          Construyendo tecnología <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent">
            por y para estudiantes
          </span>
        </h1>

        <p class="mt-6 max-w-3xl text-sm leading-relaxed text-gray-300 sm:text-base md:text-lg">
          <strong class="text-white">StellaLabs</strong> es una iniciativa estudiantil independiente nacida en las aulas de ingeniería. Un espacio para diseñar utilidades reales de campus, compartir conocimiento técnico sin rodeos y fomentar la comunidad a través de la experimentación y el desarrollo de software.
        </p>
      </div>

      <!-- 3 Pilares del laboratorio -->
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
        <!-- Pilar 1 -->
        <div class="rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:border-astra-400/40">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-astra-400/20 bg-astra-400/10 font-mono text-sm font-bold text-astra-400">
            01
          </div>
          <h3 class="mt-4 text-base font-bold text-white">Herramientas Reales</h3>
          <p class="mt-2 text-xs leading-relaxed text-gray-400">
            Desarrollo de módulos ágiles y funcionales para el día a día estudiantil, desde control de asistencias hasta prototipos interactivos.
          </p>
        </div>

        <!-- Pilar 2 -->
        <div class="rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:border-cosmic-400/40">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-cosmic-500/20 bg-cosmic-500/10 font-mono text-sm font-bold text-cosmic-400">
            02
          </div>
          <h3 class="mt-4 text-base font-bold text-white">Guías Prácticas</h3>
          <p class="mt-2 text-xs leading-relaxed text-gray-400">
            Material de apoyo para talleres presenciales y laboratorios técnicos. Comandos directos a consola, arquitecturas y cero relleno teórico.
          </p>
        </div>

        <!-- Pilar 3 -->
        <div class="rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:border-emerald-400/40">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-emerald-500/20 bg-emerald-500/10 font-mono text-sm font-bold text-emerald-400">
            03
          </div>
          <h3 class="mt-4 text-base font-bold text-white">Comunidad & E-Sports</h3>
          <p class="mt-2 text-xs leading-relaxed text-gray-400">
            Espacios de ocio y convivencia para conectar a los alumnos más allá del código a través de torneos universitarios y mini juegos.
          </p>
        </div>
      </div>

      <!-- Tarjeta inferior de colaboración / CTA -->
      <div class="mt-12 flex flex-col items-start justify-between gap-6 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl sm:flex-row sm:items-center sm:p-8">
        <div>
          <span class="font-mono text-xs uppercase tracking-wider text-astra-400">Open Source & Colaborativo</span>
          <h4 class="mt-1 text-lg font-bold text-white">¿Tienes una idea o quieres proponer un taller?</h4>
          <p class="mt-1 text-xs text-gray-400">StellaLabs crece con el aporte de cualquier estudiante interesado en colaborar.</p>
        </div>

        <div class="flex shrink-0 items-center gap-3">
          <a
            href="/contacto"
            class="rounded-xl bg-astra-400 px-5 py-2.5 text-xs font-semibold text-space-950 transition-colors hover:bg-sky-300"
          >
            Contáctanos
          </a>
          <a
            href="/"
            class="rounded-xl border border-white/10 bg-white/5 px-5 py-2.5 text-xs font-semibold text-gray-300 transition-colors hover:border-white/20 hover:text-white"
          >
            Inicio
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>