---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Acerca de | StellaLabs">
  <Header />

  <main class="relative min-h-screen pb-20 pt-28">
    <!-- Malla de fondo y resplandores -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(56,189,248,0.04)_1px,transparent_1px)] [background-size:32px_32px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-[var(--color-astra-500)]/10 blur-[150px]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-6 md:px-10">
      
      <!-- =======================================================================
           1. HERO SECTION
           ======================================================================= -->
      <div class="mb-20 text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[var(--color-astra-400)]/20 bg-[var(--color-astra-400)]/10 px-3.5 py-1 font-mono text-xs font-medium tracking-[0.10em] text-[var(--color-astra-300)] uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-astra-400)] animate-pulse"></span>
          ABOUT_US.MD
        </div>
        <h1 class="font-sans text-4xl font-medium tracking-tight text-white sm:text-5xl lg:text-6xl">
          Nuestra <span class="bg-gradient-to-r from-[var(--color-astra-400)] via-sky-300 to-[var(--color-cosmic-400)] bg-clip-text text-transparent">historia y propósito</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl font-sans text-base leading-relaxed text-[#9da7ba] md:text-lg">
          StellaLabs es el motor tecnológico e independiente impulsado por estudiantes de Ingeniería en Teleinformática del CUCSur.
        </p>
      </div>

      <!-- =======================================================================
           2. MISIÓN Y VISIÓN (Tarjetas Hero)
           ======================================================================= -->
      <div class="mb-24 grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- Misión -->
        <div class="relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-8 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all hover:border-[var(--color-glass-edge-hover)] hover:shadow-[var(--shadow-glow-astra)]">
          <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-[var(--color-astra-500)]/20 blur-[60px]" aria-hidden="true"></div>
          <h2 class="mb-3 font-mono text-sm tracking-widest text-[var(--color-astra-400)] uppercase">Misión</h2>
          <h3 class="mb-4 font-sans text-xl font-medium text-white">Conectar a la comunidad universitaria a través del software, el aprendizaje y la convivencia.</h3>
          <p class="font-sans text-sm leading-relaxed text-[#9da7ba]">
            Transformar proyectos de clase e ideas individuales en herramientas reales y abiertas para el campus, creando un ecosistema colaborativo donde los estudiantes no solo programen para una calificación, sino para impactar activamente a sus compañeros.
          </p>
        </div>

        <!-- Visión -->
        <div class="relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-8 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all hover:border-[var(--color-cosmic-400)]/40 hover:shadow-[var(--shadow-glow-cosmic)]">
          <div class="pointer-events-none absolute -bottom-10 -right-10 h-32 w-32 rounded-full bg-[var(--color-cosmic-500)]/20 blur-[60px]" aria-hidden="true"></div>
          <h2 class="mb-3 font-mono text-sm tracking-widest text-[var(--color-cosmic-400)] uppercase">Visión</h2>
          <h3 class="mb-4 font-sans text-xl font-medium text-white">Construir una tradición que trascienda generaciones.</h3>
          <p class="font-sans text-sm leading-relaxed text-[#9da7ba]">
            Consolidar un laboratorio experimental y una comunidad autónoma en la carrera de Ingeniería en Teleinformática del CUCSur, asegurando que existan eventos recurrentes, espacios de integración y plataformas en producción mantenidas de forma colaborativa por las futuras generaciones.
          </p>
        </div>
      </div>

      <!-- =======================================================================
           3. LA HISTORIA (Timeline / Manifiesto)
           ======================================================================= -->
      <div class="relative mx-auto max-w-4xl">
        <!-- Línea conectora (visible solo en md+) -->
        <div class="absolute bottom-0 left-[27px] top-0 hidden w-px bg-gradient-to-b from-[var(--color-astra-500)]/50 via-[var(--color-cosmic-500)]/30 to-transparent md:block"></div>

        <div class="mb-12 text-center md:text-left md:pl-20">
          <h2 class="font-sans text-3xl font-medium text-white">De carpetas olvidadas a <span class="text-[var(--color-astra-300)]">código en producción</span></h2>
        </div>

        <div class="space-y-12">
          <!-- Origen -->
          <div class="relative flex flex-col gap-6 md:flex-row md:items-start">
            <div class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-full border border-[var(--color-astra-400)]/30 bg-[var(--color-space-950)] md:flex relative z-10">
              <span class="font-mono text-xs text-[var(--color-astra-400)]">01</span>
            </div>
            <div class="rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 backdrop-blur-md transition-all hover:border-[var(--color-glass-edge-hover)]">
              <h3 class="mb-3 font-sans text-xl font-medium text-white">El Origen: Una identidad común</h3>
              <p class="font-sans text-sm leading-relaxed text-[#9da7ba]">
                StellaLabs no nació en una oficina ni como un trámite institucional. Surgió de una necesidad sencilla: al desarrollar un par de aplicaciones web pensadas para facilitar la vida en la facultad, se hizo evidente que faltaba un punto de encuentro. Una interfaz central con identidad propia donde todas las utilidades del campus pudieran convivir, descubrirse y usarse en el día a día. Lo que comenzó como un prototipo de interfaz fue tomando forma hasta convertirse en el laboratorio de software de la carrera.
              </p>
            </div>
          </div>

          <!-- Comunidad -->
          <div class="relative flex flex-col gap-6 md:flex-row md:items-start">
            <div class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-full border border-[var(--color-cosmic-400)]/30 bg-[var(--color-space-950)] md:flex relative z-10">
              <span class="font-mono text-xs text-[var(--color-cosmic-400)]">02</span>
            </div>
            <div class="rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 backdrop-blur-md transition-all hover:border-[var(--color-cosmic-400)]/40">
              <h3 class="mb-3 font-sans text-xl font-medium text-white">Comunidad: Rompiendo la distancia</h3>
              <p class="font-sans text-sm leading-relaxed text-[#9da7ba]">
                En la universidad es fácil pasar los días sin llegar a conocer realmente a quienes estudian contigo. ¿Por qué no usar la tecnología como pretexto para conocernos? La integración de la Liga Experimental de Torneos nació de vivir eventos universitarios con organización deficiente y decidir hacer las cosas bien. Organizar competencias de e-sports no solo trajo diversión, sino una excusa perfecta para unir a la carrera y construir comunidad.
              </p>
            </div>
          </div>

          <!-- Motivación -->
          <div class="relative flex flex-col gap-6 md:flex-row md:items-start">
            <div class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-full border border-[var(--color-astra-400)]/30 bg-[var(--color-space-950)] md:flex relative z-10">
              <span class="font-mono text-xs text-[var(--color-astra-400)]">03</span>
            </div>
            <div class="rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 backdrop-blur-md transition-all hover:border-[var(--color-glass-edge-hover)]">
              <h3 class="mb-3 font-sans text-xl font-medium text-white">Motivación y salida a producción</h3>
              <p class="font-sans text-sm leading-relaxed text-[#9da7ba]">
                Programar cobra un sentido muy distinto cuando sabes que lo que estás construyendo lo van a utilizar tus compañeros y profesores. Buscamos romper el ciclo de los proyectos que mueren en un archivo <code>.zip</code> al terminar el semestre, ofreciendo una plataforma donde el código estudiantil se despliega en producción real y sirve como motivación para aprender más.
              </p>
            </div>
          </div>

          <!-- Legado -->
          <div class="relative flex flex-col gap-6 md:flex-row md:items-start">
            <div class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-full border border-white/20 bg-[var(--color-space-950)] md:flex relative z-10">
              <span class="font-mono text-xs text-white">04</span>
            </div>
            <div class="rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 backdrop-blur-md transition-all hover:border-white/30">
              <h3 class="mb-3 font-sans text-xl font-medium text-white">Un legado colaborativo</h3>
              <p class="font-sans text-sm leading-relaxed text-[#9da7ba]">
                La verdadera meta es que este espacio no dependa de una sola persona. Queremos haber sembrado la costumbre de organizar eventos técnicos y recreativos de forma abierta, siendo el motor que mejore la visibilidad de Teleinformática en el CUCSur y un lugar donde cada estudiante sienta que pertenece.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- =======================================================================
           4. VALORES / PILARES
           ======================================================================= -->
      <div class="mt-32">
        <div class="mb-12 text-center">
          <h2 class="font-sans text-3xl font-medium text-white">Nuestros Pilares</h2>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Pilar 1 -->
          <div class="flex flex-col items-center text-center rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 backdrop-blur-md hover:border-[var(--color-astra-400)]/40 transition-colors">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-[var(--radius-input)] bg-[var(--color-astra-400)]/10 text-[var(--color-astra-400)]">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
            </div>
            <h3 class="mb-2 font-sans text-lg font-medium text-white">Colaboración Abierta</h3>
            <p class="font-sans text-xs leading-relaxed text-[#9da7ba]">Espacio donde cualquier alumno puede proponer utilidades, enviar Pull Requests y aportar ideas sin trabas.</p>
          </div>

          <!-- Pilar 2 -->
          <div class="flex flex-col items-center text-center rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 backdrop-blur-md hover:border-emerald-400/40 transition-colors">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-[var(--radius-input)] bg-emerald-500/10 text-emerald-400">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3 class="mb-2 font-sans text-lg font-medium text-white">Impacto Universitario</h3>
            <p class="font-sans text-xs leading-relaxed text-[#9da7ba]">Priorizamos construir software práctico que resuelva necesidades reales de nuestra facultad y compañeros.</p>
          </div>

          <!-- Pilar 3 -->
          <div class="flex flex-col items-center text-center rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 backdrop-blur-md hover:border-[var(--color-cosmic-400)]/40 transition-colors">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-[var(--radius-input)] bg-[var(--color-cosmic-400)]/10 text-[var(--color-cosmic-400)]">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            </div>
            <h3 class="mb-2 font-sans text-lg font-medium text-white">Integración y Convivencia</h3>
            <p class="font-sans text-xs leading-relaxed text-[#9da7ba]">Apasionados de la tecnología que entienden que la comunidad se fortalece cuando nos conocemos cara a cara.</p>
          </div>

          <!-- Pilar 4 -->
          <div class="flex flex-col items-center text-center rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 backdrop-blur-md hover:border-amber-400/40 transition-colors">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-[var(--radius-input)] bg-amber-500/10 text-amber-400">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
            </div>
            <h3 class="mb-2 font-sans text-lg font-medium text-white">Continuidad y Legado</h3>
            <p class="font-sans text-xs leading-relaxed text-[#9da7ba]">Un proyecto pensado, documentado y estructurado para perdurar y ser tomado por las siguientes generaciones.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- =======================================================================
           5. ENLACES RÁPIDOS
           ======================================================================= -->
      <div class="mt-24 flex flex-col items-center justify-center gap-4 border-t border-[var(--color-glass-edge)] pt-16 sm:flex-row">
        <a 
          href="/" 
          class="group inline-flex items-center gap-2 rounded-full border border-[var(--color-glass-edge)] bg-white/[0.04] px-6 py-3 font-mono text-xs font-medium uppercase tracking-[0.10em] text-white transition-all duration-200 hover:border-[var(--color-glass-edge-hover)] hover:bg-white/[0.08]"
        >
          <span class="transition-transform duration-200 group-hover:-translate-x-1">←</span>
          <span>Volver al inicio</span>
        </a>
        
        <a 
          href="https://teleinformatica.stellalabs.tech/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group inline-flex items-center gap-2 rounded-full border border-transparent bg-[var(--color-astra-500)] px-6 py-3 font-mono text-xs font-medium uppercase tracking-[0.10em] text-black transition-all duration-200 hover:bg-[var(--color-astra-400)] hover:shadow-[var(--shadow-glow-astra)]"
        >
          <span>Portal oficial de la carrera</span>
          <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
  </main>

  <Footer />
</Layout>