---
import Layout from "../layouts/Layout.astro";
import Isotipo from "../components/Isotipo.astro";

const stars = Array.from({ length: 60 }, (_, i) => ({
  id: i,
  top: Math.random() * 100,
  left: Math.random() * 100,
  size: Math.random() * 2 + 1,
  delay: Math.random() * 5,
  duration: 3 + Math.random() * 4,
}));

const links = [
  { label: "Registro de eventos", href: "/eventos" },
  { label: "Torneos", href: "/torneos" },
  { label: "Mini juegos", href: "/juegos" },
  { label: "Guías", href: "/guias" },
  { label: "Labs", href: "/labs" },
];
---

<Layout>
  <div class="relative min-h-screen overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(56,189,248,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(56,189,248,0.05)_1px,transparent_1px)] bg-size-[48px_48px] mask-[radial-gradient(ellipse_at_center,black_20%,transparent_75%)]"
      >
      </div>
      {
        stars.map((s) => (
          <span
            class="star absolute rounded-full bg-white opacity-20"
            style={`top:${s.top}%;left:${s.left}%;width:${s.size}px;height:${s.size}px;animation-delay:${s.delay}s;animation-duration:${s.duration}s`}
          />
        ))
      }
    </div>

    <main class="relative z-10 flex min-h-screen flex-col items-center justify-center px-5 py-12">
      <span
        class="mb-6 inline-flex items-center gap-2 rounded-pill border border-glass-edge bg-glass-surface px-3.5 py-1.5 font-mono text-xs tracking-wider text-astra-300 backdrop-blur-md"
      >
        <span class="size-1.5 rounded-full bg-red-400 shadow-[0_0_8px_rgba(248,113,113,0.8)]"></span>
        MODULE_404 // SIGNAL_LOST
      </span>

      <h1
        class="flex items-center justify-center gap-1 text-[clamp(5rem,22vw,9rem)] leading-none font-bold tracking-tighter sm:gap-3"
        aria-label="Error 404"
      >
        <span class="bg-linear-to-br text-astra-500 bg-clip-text" aria-hidden="true">4</span>
        <Isotipo class="w-[0.78em] shrink-0" />
        <span class="bg-linear-to-br text-astra-500 bg-clip-text" aria-hidden="true">4</span>
      </h1>

      <h2 class="mt-6 max-w-2xl text-center text-3xl leading-tight font-bold tracking-tight text-white sm:text-4xl">
        Esta ruta no existe <span class="bg-linear-to-r from-astra-400 to-cosmic-400 bg-clip-text text-transparent">en el laboratorio.</span>
      </h2>
      <p class="mt-4 max-w-xl text-center leading-relaxed text-slate-300/70">
        Puede que el enlace esté mal escrito, que la página haya cambiado de lugar o que todavía sea un experimento en desarrollo.
      </p>

      <!-- Ventana de terminal -->
      <div
        class="mt-8 w-full max-w-xl overflow-hidden rounded-card border border-glass-edge bg-glass-surface shadow-glass-card backdrop-blur-xl"
        role="note"
      >
        <div class="flex items-center gap-2 border-b border-glass-edge bg-space-900/80 px-4 py-2.5">
          <span class="size-2.5 rounded-full bg-red-400/70"></span>
          <span class="size-2.5 rounded-full bg-yellow-400/70"></span>
          <span class="size-2.5 rounded-full bg-green-400/70"></span>
          <span class="ml-2 font-mono text-xs text-slate-400">guest@stellalabs:~</span>
        </div>
        <div class="space-y-1.5 overflow-x-auto px-4 py-4 font-mono text-sm whitespace-nowrap">
          <p>
            <span class="text-cosmic-400">➜</span>
            <span class="text-slate-400">~</span>
            <span class="text-slate-200">curl -I </span><span id="path" class="text-astra-400">/ruta-desconocida</span>
          </p>
          <p><span class="text-red-400">HTTP/1.1 404 Not Found</span></p>
          <p class="text-slate-400">
            route: <span class="text-slate-200">undefined</span> • status: <span class="text-slate-200">lost_in_space</span>
          </p>
          <p>
            <span class="text-cosmic-400">➜</span>
            <span class="text-slate-400">~</span>
            <span class="cursor ml-1 inline-block h-4 w-2 translate-y-0.5 bg-astra-400"></span>
          </p>
        </div>
      </div>

      <div class="mt-8 flex w-full max-w-xl flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-pill bg-astra-500 px-6 py-3 text-[0.95rem] font-semibold text-white shadow-glow-astra transition hover:-translate-y-0.5 hover:bg-astra-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-astra-400"
        >
          Volver al inicio
        </a>
        <button
          type="button"
          id="back"
          class="inline-flex cursor-pointer items-center justify-center rounded-pill border border-cosmic-400/35 bg-transparent px-6 py-3 text-[0.95rem] font-semibold text-cosmic-400 transition hover:-translate-y-0.5 hover:border-cosmic-400 hover:bg-cosmic-500/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cosmic-400"
        >
          Regresar
        </button>
      </div>

      <nav class="mt-10 flex max-w-xl flex-wrap justify-center gap-2" aria-label="Accesos rápidos">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="rounded-pill border border-glass-edge bg-glass-surface px-3.5 py-1.5 text-sm text-slate-300 transition hover:border-glass-edge-hover hover:text-astra-300"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <p class="mt-12 text-center font-mono text-xs text-slate-500">
        StellaLabs — © 2026. Ingeniería en Teleinformática, CUCSur.
      </p>
    </main>
  </div>
</Layout>

<script>
  const path = document.getElementById("path");
  if (path) path.textContent = window.location.pathname;
  document.getElementById("back")?.addEventListener("click", () => {
    if (history.length > 1) history.back();
    else window.location.href = "/";
  });
</script>

<style is:global>
  @keyframes twinkle {
    0%, 100% { opacity: 0.15; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.4); }
  }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  .star { animation-name: twinkle; animation-timing-function: ease-in-out; animation-iteration-count: infinite; }
  .cursor { animation: blink 1.1s steps(1) infinite; }

  @media (prefers-reduced-motion: reduce) {
    .star, .cursor { animation: none; }
  }
</style>