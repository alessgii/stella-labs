---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="StellaLabs — Herramientas">
  <Header />

  <main class="relative min-h-[calc(100vh-14rem)] overflow-hidden px-6 py-16 md:px-10 lg:py-24">
    <!-- Luces y atmósfera ambiental StellaLabs -->
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(#38bdf810_1px,transparent_1px)] [background-size:28px_28px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -top-24 right-1/4 h-[400px] w-[400px] rounded-full bg-astra-400/10 blur-[140px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute bottom-1/4 -left-24 h-[380px] w-[380px] rounded-full bg-cosmic-500/10 blur-[140px]"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-6xl">
      <!-- Encabezado de la página -->
      <header class="mb-14 text-center md:text-left">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-astra-400/20 bg-astra-400/10 px-3.5 py-1 text-xs font-mono text-astra-400">
          <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"></span>
          SUITE DE UTILIDADES // LABORATORIO ACTIVO
        </div>

        <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl">
          Ecosistema de <span class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent">herramientas de campus</span>
        </h1>

        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-gray-300 sm:text-base md:text-lg">
          Módulos funcionales, plataformas de comunidad y recursos técnicos desarrollados para optimizar actividades estudiantiles, talleres y eventos universitarios.
        </p>
      </header>

      <!-- Grid de las 4 herramientas -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
        
        <!-- HERRAMIENTA 1: Registro de Eventos -->
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-astra-400/50 hover:shadow-[0_10px_35px_-10px_rgba(56,189,248,0.15)] sm:p-8">
          <div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-astra-400/30 bg-astra-400/10 text-astra-400">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-400">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span> ACTIVO
              </span>
            </div>

            <h2 class="mt-6 text-xl font-bold text-white transition-colors group-hover:text-astra-400">
              Control de Asistencias & Eventos
            </h2>
            <p class="mt-3 text-xs leading-relaxed text-gray-400 sm:text-sm">
              Kiosko ágil para el registro en conferencias y talleres. Compatible con lectores de código de barras de credenciales de estudiante, conteo correlativo y panel administrativo para creación de sesiones.
            </p>

            <div class="mt-6 flex flex-wrap gap-2 font-mono text-[11px] text-gray-400">
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Código de barras / Manual</span>
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Panel Admin</span>
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Métricas en vivo</span>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-white/5">
            <a
              href="/eventos"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-astra-400 px-4 py-3 text-xs font-bold uppercase tracking-wider text-space-950 transition-all hover:bg-sky-300 active:scale-95"
            >
              Iniciar módulo de asistencias
              <span>→</span>
            </a>
          </div>
        </article>

        <!-- HERRAMIENTA 2: Torneos de Videojuegos -->
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-cosmic-400/50 hover:shadow-[0_10px_35px_-10px_rgba(168,85,247,0.15)] sm:p-8">
          <div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-cosmic-500/30 bg-cosmic-500/10 text-cosmic-400">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="inline-flex items-center rounded-full border border-cosmic-400/30 bg-cosmic-500/10 px-2.5 py-0.5 font-mono text-[10px] font-bold text-cosmic-300">
                LIGA ACTIVA
              </span>
            </div>

            <h2 class="mt-6 text-xl font-bold text-white transition-colors group-hover:text-cosmic-400">
              Torneos & Liga Universitaria
            </h2>
            <p class="mt-3 text-xs leading-relaxed text-gray-400 sm:text-sm">
              Plataforma de inscripción y seguimiento competitivo en Super Smash Bros. Ultimate, Mario Kart 8 Deluxe y Clash Royale. Información de brackets, modalidades y reglamentos.
            </p>

            <div class="mt-6 flex flex-wrap gap-2 font-mono text-[11px] text-gray-400">
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Smash Ultimate</span>
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Mario Kart 8</span>
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Clash Royale</span>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-white/5">
            <a
              href="/torneos"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-xs font-bold uppercase tracking-wider text-white transition-all hover:border-cosmic-500 hover:bg-cosmic-500 hover:text-white"
            >
              Explorar torneos y registrarme
              <span>→</span>
            </a>
          </div>
        </article>

        <!-- HERRAMIENTA 3: Guías Técnicas -->
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/50 hover:shadow-[0_10px_35px_-10px_rgba(56,189,248,0.15)] sm:p-8">
          <div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-sky-400/30 bg-sky-400/10 text-sky-400">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="inline-flex items-center rounded-full border border-sky-400/30 bg-sky-400/10 px-2.5 py-0.5 font-mono text-[10px] font-bold text-sky-300">
                KNOWLEDGE BASE
              </span>
            </div>

            <h2 class="mt-6 text-xl font-bold text-white transition-colors group-hover:text-sky-400">
              Guías Técnicas & Mini Cursos
            </h2>
            <p class="mt-3 text-xs leading-relaxed text-gray-400 sm:text-sm">
              Documentación paso a paso para talleres presenciales y consulta rápida en móvil. Incluye la guía completa de despliegue de Debian en VMware y configuración de servidores web Apache.
            </p>

            <div class="mt-6 flex flex-wrap gap-2 font-mono text-[11px] text-gray-400">
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Taller Linux</span>
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Git (Próx)</span>
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Web Dev (Próx)</span>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-white/5">
            <a
              href="/guias"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-xs font-bold uppercase tracking-wider text-white transition-all hover:border-sky-400 hover:bg-sky-400 hover:text-space-950"
            >
              Consultar catálogo de guías
              <span>→</span>
            </a>
          </div>
        </article>

        <!-- HERRAMIENTA 4: Mini Juegos -->
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-indigo-400/50 hover:shadow-[0_10px_35px_-10px_rgba(99,102,241,0.15)] sm:p-8">
          <div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-indigo-400/30 bg-indigo-400/10 text-indigo-400">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
                </svg>
              </div>
              <span class="inline-flex items-center rounded-full border border-indigo-400/30 bg-indigo-500/10 px-2.5 py-0.5 font-mono text-[10px] font-bold text-indigo-300">
                SANDBOX
              </span>
            </div>

            <h2 class="mt-6 text-xl font-bold text-white transition-colors group-hover:text-indigo-400">
              Mini Juegos & Banco de Pruebas
            </h2>
            <p class="mt-3 text-xs leading-relaxed text-gray-400 sm:text-sm">
              Implementaciones experimentales de lógica de videojuegos, motores en Canvas y dinámicas de recreación creadas para despejar la mente entre clases o probar algoritmos.
            </p>

            <div class="mt-6 flex flex-wrap gap-2 font-mono text-[11px] text-gray-400">
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Canvas 2D</span>
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Lógica & Pathfinding</span>
              <span class="rounded-md border border-white/5 bg-white/5 px-2.5 py-1">Recreación</span>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-white/5">
            <a
              href="/juegos"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-xs font-bold uppercase tracking-wider text-white transition-all hover:border-indigo-400 hover:bg-indigo-400 hover:text-space-950"
            >
              Entrar a mini juegos
              <span>→</span>
            </a>
          </div>
        </article>

      </div>

      <!-- Tarjeta inferior informativa / Contribuciones -->
      <section class="mt-14 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl sm:p-8">
        <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
          <div>
            <span class="font-mono text-xs uppercase tracking-wider text-astra-400">Desarrollo Abierto</span>
            <h3 class="mt-1 text-base font-bold text-white sm:text-lg">¿Tienes un proyecto o utilidad para el campus?</h3>
            <p class="mt-1 text-xs text-gray-400">Puedes integrar tus herramientas al ecosistema de StellaLabs.</p>
          </div>
          <a
            href="/contacto"
            class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-white/15 bg-white/10 px-5 py-2.5 text-xs font-semibold text-white transition-colors hover:border-astra-400 hover:bg-white/20"
          >
            Proponer módulo
            <span>→</span>
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>