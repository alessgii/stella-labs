---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import TerminalWorkspace from "../components/TerminalWorkspace.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="StellaLabs | Laboratorio de Teleinformática, CUCSur">
  <Header />

  <main
    class="relative flex min-h-[calc(100vh-5rem)] items-center justify-center overflow-hidden px-6 py-16 md:px-10"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(56,189,248,0.06)_1px,transparent_1px)] [background-size:32px_32px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -top-40 right-1/4 h-112.5 w-112.5 rounded-full bg-astra-400/10 blur-[140px]"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16"
    >
      <div
        class="flex flex-col items-center text-center lg:col-span-7 lg:items-start lg:text-left"
      >
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-astra-400/20 bg-astra-400/10 px-3.5 py-1 font-mono text-xs font-medium tracking-[0.10em] text-astra-300"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"
          ></span>
          Ing. en Teleinformática · CUCSur
        </div>
        <h1
          class="max-w-2xl font-sans text-4xl font-medium tracking-tight text-white sm:text-5xl lg:text-6xl lg:leading-[1.12]"
        >
          Software hecho <span
            class="bg-linear-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent"
            >por y para estudiantes.</span
          >
        </h1>

        <p
          class="mt-6 max-w-xl font-sans text-base leading-relaxed text-[#9da7ba] md:text-lg"
        >
          Si un proyecto de clase o un problema del campus merece una
          herramienta de verdad, aquí la programamos, la publicamos y la
          mantenemos con el código abierto.
        </p>

        <div
          class="mt-10 flex flex-wrap items-center justify-center gap-4 lg:justify-start"
        >
          <Button href="#herramientas" variant="primary"
            >Ver herramientas</Button
          >
          <Button href="#proposito" variant="secondary"
            >Sobre el proyecto</Button
          >
        </div>

        <a
          href="https://teleinformatica.stellalabs.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-12 inline-flex items-center gap-1.5 font-mono text-xs text-[#9da7ba] underline underline-offset-4 transition-colors hover:text-astra-300"
        >
          Portal de la carrera
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <div
        class="hidden relative md:flex w-full justify-center lg:col-span-5 lg:justify-end"
      >
        <div
          class="w-full max-w-lg rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-5 shadow-[var(--shadow-glass-card)] backdrop-blur-xl transition-all duration-300 hover:border-[var(--color-glass-edge-hover)]"
        >
          <div
            class="mb-4 flex items-center justify-between border-b border-[var(--color-glass-edge)] pb-3"
          >
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="font-mono text-xs tracking-wider text-[#9da7ba]"
              >stellalabs-workspace.config</span
            >
            <span
              class="font-mono text-[10px] tracking-widest uppercase text-astra-400/80"
              >sh</span
            >
          </div>

          <div class="w-full">
            <TerminalWorkspace />
          </div>
        </div>
      </div>
    </div>
  </main>
  <section
    id="proposito"
    class="relative w-full overflow-hidden border-t border-[var(--color-glass-edge)] px-6 py-20 md:px-10 lg:py-28"
  >
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 h-[380px] w-[550px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cosmic-500/10 blur-[150px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-7xl">
      <div class="mx-auto max-w-3xl text-center">
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-astra-400/20 bg-astra-400/10 px-3.5 py-1 font-mono text-xs tracking-[0.10em] text-astra-300"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"
          ></span>
          INICIATIVA INDEPENDIENTE
        </div>
        <h2
          class="font-sans text-3xl font-medium tracking-tight text-white sm:text-4xl md:text-5xl"
        >
          ¿Por qué existe <span
            class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent"
            >StellaLabs?</span
          >
        </h2>
        <p
          class="mt-5 font-sans text-base leading-relaxed text-[#9da7ba] sm:text-lg"
        >
          Al terminar el semestre, muchos proyectos de clase acaban en un .zip
          que nadie vuelve a abrir. En StellaLabs los desplegamos, los
          documentamos y los mantenemos entre quienes los usamos.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-3">
        <div
          class="rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-7 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all duration-300 hover:border-[var(--color-glass-edge-hover)] hover:shadow-[var(--shadow-glow-astra)]"
        >
          <span class="font-mono text-2xl font-medium text-astra-400">01</span>
          <h3 class="mt-4 font-sans text-lg font-medium text-white">
            Software que sí se usa
          </h3>
          <p class="mt-2 font-sans text-sm leading-relaxed text-[#9da7ba]">
            Aprendes a desplegar y documentar software que estudiantes y
            profesores ya usan.
          </p>
        </div>

        <div
          class="rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-7 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all duration-300 hover:border-cosmic-400/40 hover:shadow-[var(--shadow-glow-cosmic)]"
        >
          <span class="font-mono text-2xl font-medium text-cosmic-400">02</span>
          <h3 class="mt-4 font-sans text-lg font-medium text-white">
            Sin papeleo
          </h3>
          <p class="mt-2 font-sans text-sm leading-relaxed text-[#9da7ba]">
            Si una idea resuelve algo de la carrera, pasa de prototipo a
            producción sin trámites de por medio.
          </p>
        </div>

        <div
          class="rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-7 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all duration-300 hover:border-[var(--color-glass-edge-hover)] hover:shadow-[var(--shadow-glow-astra)]"
        >
          <span class="font-mono text-2xl font-medium text-astra-300">03</span>
          <h3 class="mt-4 font-sans text-lg font-medium text-white">
            Código abierto
          </h3>
          <p class="mt-2 font-sans text-sm leading-relaxed text-[#9da7ba]">
            Cualquiera puede leer el código, corregirlo y seguir construyendo
            encima. La siguiente generación no empieza de cero.
          </p>
        </div>
      </div>

      <div class="mt-10 flex justify-center">
        <a
          href="/acerca-de"
          class="group inline-flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-[0.10em] text-astra-400 transition-colors hover:text-white"
        >
          <span>Historia y equipo</span>
          <span
            class="transition-transform duration-200 group-hover:translate-x-1"
            >→</span
          >
        </a>
      </div>
    </div>
  </section>

  <section
    id="herramientas"
    class="relative w-full border-t border-[var(--color-glass-edge)] px-6 py-20 md:px-10 lg:py-24"
  >
    <div class="mx-auto max-w-7xl">
      <div class="mb-14 text-center md:text-left">
        <span
          class="font-mono text-xs uppercase tracking-[0.10em] text-astra-400"
          >Módulos en desarrollo</span
        >
        <h2 class="mt-2 font-sans text-3xl font-medium text-white sm:text-4xl">
          Lo que estamos construyendo
        </h2>
        <p class="mt-3 max-w-xl font-sans text-base text-[#9da7ba]">
          Cada módulo resuelve un problema concreto del campus y, de paso, nos
          sirve para practicar arquitectura de software.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <a
          href="/eventos"
          class="group relative flex flex-col justify-between overflow-hidden rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-8 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-glass-edge-hover)] hover:shadow-[var(--shadow-glow-astra)]"
        >
          <div>
            <div
              class="mb-6 flex h-12 w-12 items-center justify-center rounded-[var(--radius-input,8px)] border border-astra-400/25 bg-astra-400/10 text-astra-400 transition-colors group-hover:border-astra-400/50"
            >
              <svg
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3
              class="font-sans text-xl font-medium text-white transition-colors group-hover:text-astra-400"
            >
              Registro de Eventos
            </h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-[#9da7ba]">
              Inscripción y asistencia para conferencias, talleres y
              convocatorias, todo en un solo lugar y sin formularios sueltos.
            </p>
          </div>
          <div
            class="mt-8 flex items-center gap-2 font-mono text-xs font-medium tracking-wider text-astra-400"
          >
            <span>Disponible</span>
            <span class="transition-transform group-hover:translate-x-1">→</span
            >
          </div>
        </a>

        <a
          href="/juegos"
          class="group relative flex flex-col justify-between overflow-hidden rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-8 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-cosmic-400/50 hover:shadow-[var(--shadow-glow-cosmic)]"
        >
          <div>
            <div
              class="mb-6 flex h-12 w-12 items-center justify-center rounded-[var(--radius-input,8px)] border border-cosmic-400/25 bg-cosmic-400/10 text-cosmic-400 transition-colors group-hover:border-cosmic-400/50"
            >
              <svg
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"
                ></path>
              </svg>
            </div>
            <h3
              class="font-sans text-xl font-medium text-white transition-colors group-hover:text-cosmic-400"
            >
              Mini Juegos & Sandbox
            </h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-[#9da7ba]">
              Juegos que programamos los alumnos para probar algoritmos:
              búsqueda de rutas, lógica de tableros y lo que se nos ocurra.
            </p>
          </div>
          <div
            class="mt-8 flex items-center gap-2 font-mono text-xs font-medium tracking-wider text-cosmic-400"
          >
            <span>En pruebas</span>
            <span class="transition-transform group-hover:translate-x-1">→</span
            >
          </div>
        </a>

        <a
          href="/herramientas"
          class="group relative flex flex-col justify-between overflow-hidden rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-8 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-glass-edge-hover)] hover:shadow-[var(--shadow-glow-astra)]"
        >
          <div>
            <div
              class="mb-6 flex h-12 w-12 items-center justify-center rounded-[var(--radius-input,8px)] border border-astra-300/25 bg-astra-300/10 text-astra-300 transition-colors group-hover:border-astra-300/50"
            >
              <svg
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3
              class="font-sans text-xl font-medium text-white transition-colors group-hover:text-astra-300"
            >
              APIs & Microservicios
            </h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-[#9da7ba]">
              Endpoints, lectura de horarios y utilidades pequeñas que cualquier
              proyecto de la facultad puede usar como base.
            </p>
          </div>
          <div
            class="mt-8 flex items-center gap-2 font-mono text-xs font-medium tracking-wider text-astra-300"
          >
            <span>En diseño</span>
            <span class="transition-transform group-hover:translate-x-1">→</span
            >
          </div>
        </a>
      </div>
    </div>
  </section>

  <section
    id="guias"
    class="relative w-full overflow-hidden border-t border-[var(--color-glass-edge)] px-6 py-20 md:px-10 lg:py-24"
  >
    <div
      class="pointer-events-none absolute right-1/4 top-0 h-[380px] w-[500px] rounded-full bg-astra-400/10 blur-[140px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-7xl">
      <div
        class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end mb-12 sm:mb-16"
      >
        <div class="max-w-2xl">
          <div
            class="mb-4 inline-flex items-center gap-2 rounded-full border border-astra-400/20 bg-astra-400/10 px-3.5 py-1 font-mono text-xs tracking-[0.10em] text-astra-300"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"
            ></span>
            KNOWLEDGE BASE
          </div>
          <h2
            class="font-sans text-3xl font-medium tracking-tight text-white sm:text-4xl lg:text-5xl"
          >
            Guías técnicas y <span
              class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent"
              >mini cursos</span
            >
          </h2>
          <p
            class="mt-4 font-sans text-sm leading-relaxed text-[#9da7ba] sm:text-base"
          >
            Los apuntes de nuestros talleres, para seguirlos paso a paso en el
            laboratorio.
          </p>
        </div>

        <a
          href="/guias"
          class="inline-flex shrink-0 items-center gap-2 rounded-full border border-[var(--color-glass-edge)] bg-white/[0.04] px-5 py-2.5 font-mono text-xs font-medium tracking-wider text-[#d1e4fa] transition-all duration-200 hover:border-[var(--color-glass-edge-hover)] hover:bg-white/[0.08] hover:text-white"
        >
          <span>Ver todas las guías</span>
          <span
            class="text-astra-400 transition-transform group-hover:translate-x-1"
            >→</span
          >
        </a>
      </div>

      <div
        class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3"
      >
        <div
          class="group relative flex flex-col justify-between rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-glass-edge-hover)] hover:shadow-[var(--shadow-glow-astra)] sm:p-7"
        >
          <div>
            <div
              class="flex items-center justify-between border-b border-[var(--color-glass-edge)] pb-4"
            >
              <div
                class="flex h-10 w-10 items-center justify-center rounded-[var(--radius-input,8px)] border border-astra-400/30 bg-astra-400/10 text-astra-400"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <span
                class="rounded-[var(--radius-badge,6px)] border border-emerald-500/25 bg-emerald-500/15 px-2 py-0.5 font-mono text-[10px] font-medium tracking-wider text-emerald-400 uppercase"
              >
                DISPONIBLE
              </span>
            </div>

            <h3
              class="mt-5 font-sans text-lg font-medium text-white transition-colors group-hover:text-astra-400"
            >
              Introducción a Linux & Servidores
            </h3>
            <p
              class="mt-2 font-sans text-xs leading-relaxed text-[#9da7ba] sm:text-sm"
            >
              Instalas Debian con GNOME en una máquina virtual de VMware,
              aprendes los comandos básicos de la terminal y dejas un servidor
              Apache funcionando.
            </p>

            <div
              class="mt-4 flex items-center gap-3 font-mono text-[11px] tracking-wider text-[#9da7ba]"
            >
              <span class="text-astra-400">4 horas</span>
              <span>•</span>
              <span>Taller presencial</span>
            </div>
          </div>

          <div class="mt-6 border-t border-[var(--color-glass-edge)] pt-4">
            <a
              href="/guias/linux"
              class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-astra-500 px-4 py-2.5 font-mono text-xs font-medium tracking-wider text-space-950 transition-all duration-200 hover:bg-astra-400 hover:shadow-[var(--shadow-glow-astra)]"
            >
              Abrir guía del taller
              <span>→</span>
            </a>
          </div>
        </div>

        <div
          class="relative flex flex-col justify-between rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 shadow-[var(--shadow-glass-card)] backdrop-blur-md sm:p-7"
        >
          <div>
            <div
              class="flex items-center justify-between border-b border-[var(--color-glass-edge)] pb-4"
            >
              <div
                class="flex h-10 w-10 items-center justify-center rounded-[var(--radius-input,8px)] border border-[var(--color-glass-edge)] bg-white/5 text-[#9da7ba]"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"
                  ></path>
                </svg>
              </div>
              <span
                class="rounded-[var(--radius-badge,6px)] border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-medium tracking-wider text-amber-300 uppercase"
              >
                PRÓXIMAMENTE
              </span>
            </div>

            <h3 class="mt-5 font-sans text-lg font-medium text-white">
              Git, GitHub & Flujos de Trabajo
            </h3>
            <p
              class="mt-2 font-sans text-xs leading-relaxed text-[#9da7ba] sm:text-sm"
            >
              Cómo trabajar en equipo sin pisarse el código: ramas, conflictos
              de merge y Pull Requests.
            </p>

            <div
              class="mt-4 flex items-center gap-3 font-mono text-[11px] tracking-wider text-[#9da7ba]"
            >
              <span>Terminal + Web</span>
              <span>•</span>
              <span class="text-amber-400/80">En redacción</span>
            </div>
          </div>

          <div class="mt-6 border-t border-[var(--color-glass-edge)] pt-4">
            <button
              disabled
              class="w-full cursor-not-allowed rounded-full border border-[var(--color-glass-edge)] bg-white/[0.03] py-2.5 text-center font-mono text-xs font-medium tracking-wider text-slate-500"
            >
              En preparación
            </button>
          </div>
        </div>

        <div
          class="relative flex flex-col justify-between rounded-[var(--radius-card,16px)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-6 shadow-[var(--shadow-glass-card)] backdrop-blur-md sm:p-7"
        >
          <div>
            <div
              class="flex items-center justify-between border-b border-[var(--color-glass-edge)] pb-4"
            >
              <div
                class="flex h-10 w-10 items-center justify-center rounded-[var(--radius-input,8px)] border border-[var(--color-glass-edge)] bg-white/5 text-[#9da7ba]"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
