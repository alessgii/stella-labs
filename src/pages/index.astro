---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import TerminalWorkspace from "../components/TerminalWorkspace.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="StellaLabs | Laboratorio Experimental">
  <Header />

  <!-- HERO SECTION -->
  <main class="relative flex min-h-[calc(100vh-5rem)] items-center justify-center overflow-hidden px-6 py-16 md:px-10">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(#38bdf810_1px,transparent_1px)] [background-size:32px_32px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -top-40 right-1/4 h-[450px] w-[450px] rounded-full bg-sky-500/10 blur-[130px]"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Columna izquierda: Propuesta de valor -->
      <div class="flex flex-col items-center text-center lg:col-span-7 lg:items-start lg:text-left">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-sky-500/20 bg-sky-500/10 px-3.5 py-1 text-xs font-medium text-sky-400">
          <span class="h-1.5 w-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          Laboratorio Experimental de Software
        </div>

        <h1 class="max-w-2xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl lg:leading-[1.12]">
          El laboratorio de <span class="bg-gradient-to-r from-sky-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent">software y utilidades</span> hecho por y para estudiantes.
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-gray-300 md:text-lg">
          Un espacio donde convertimos ideas, proyectos de clase y necesidades del día a día en herramientas reales, abiertas y listas para producción.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
          <Button href="/eventos" variant="primary">Explorar herramientas</Button>
          <Button href="#proposito" variant="secondary">Conocer el proyecto</Button>
        </div>

        <a
          href="https://teleinformatica.stellalabs.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-12 inline-flex items-center gap-1.5 text-sm text-gray-400 underline underline-offset-4 transition-colors hover:text-white"
        >
          Visita el portal oficial de la carrera
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Columna derecha: Mockup / Ventana interactiva (en lugar del logo plano) -->
      <div class="relative flex w-full justify-center lg:col-span-5 lg:justify-end">
        <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-slate-950/70 p-5 shadow-2xl backdrop-blur-xl">
          <!-- Ventana Header -->
          <div class="mb-4 flex items-center justify-between border-b border-white/5 pb-3">
            
            <span class="font-mono text-xs text-gray-500">stellalabs-workspace.config</span>
          </div>

          <div class="relative flex w-full justify-center lg:col-span-5 lg:justify-end">
        <TerminalWorkspace />
          </div>  <!-- -->
        </div>
      </div>
    </div>
  </main>

  <!-- BENTO GRID DE HERRAMIENTAS -->
  <section id="herramientas" class="relative w-full border-t border-white/10 px-6 py-24 md:px-10">
    <div class="mx-auto max-w-7xl">
      <div class="mb-16 text-center md:text-left">
        <span class="font-mono text-xs uppercase tracking-wider text-sky-400">Módulos en desarrollo</span>
        <h2 class="mt-2 text-3xl font-extrabold text-white sm:text-4xl">Lo que estamos construyendo</h2>
        <p class="mt-3 max-w-xl text-base text-gray-400">Herramientas concretas pensadas para solucionar dinámicas de la carrera y experimentar con tecnología moderna.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Bento 1 -->
        <div class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-slate-950/40 p-8 transition-all hover:border-sky-500/40 hover:bg-slate-900/40">
          <div>
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/20">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white">Registro de Eventos</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">
              Plataforma para dar seguimiento a torneos, conferencias y talleres internos sin depender de formularios externos desorganizados.
            </p>
          </div>
          <div class="mt-8 flex items-center gap-2 text-xs font-medium text-sky-400">
            Acceso habilitado <span>→</span>
          </div>
        </div>

        <!-- Bento 2 -->
        <div class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-slate-950/40 p-8 transition-all hover:border-indigo-500/40 hover:bg-slate-900/40">
          <div>
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white">Mini Juegos & Sandbox</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">
              Espacio lúdico para probar algoritmos de lógica, inteligencia de tableros y retos interactivos programados directamente por compañeros.
            </p>
          </div>
          <div class="mt-8 flex items-center gap-2 text-xs font-medium text-indigo-400">
            Módulos experimentales <span>→</span>
          </div>
        </div>

        <!-- Bento 3 -->
        <div class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-slate-950/40 p-8 transition-all hover:border-blue-500/40 hover:bg-slate-900/40">
          <div>
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white">APIs y Utilidades Abiertas</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">
              Endpoints, parsers y microservicios diseñados para automatizar tareas del campus y servir como base para nuevos desarrollos.
            </p>
          </div>
          <div class="mt-8 flex items-center gap-2 text-xs font-medium text-blue-400">
            En fase de diseño <span>→</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN: LOS 3 PILARES (PROPÓSITO) -->
  <section id="proposito" class="relative w-full border-t border-white/10 px-6 py-24 md:px-10">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          ¿Por qué existe StellaLabs<span class="text-accent">?</span>
        </h2>
        <p class="mt-4 text-base text-gray-400 sm:text-lg">
          Muchos de los mejores proyectos universitarios se quedan olvidados en carpetas comprimidas al terminar el semestre. Queremos cambiar esa dinámica.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-6">
          <span class="font-mono text-2xl font-bold text-sky-400">01</span>
          <h3 class="mt-3 text-lg font-bold text-white">Salida a producción real</h3>
          <p class="mt-2 text-sm text-gray-400">
            Aprender a desplegar, mantener y documentar software que otras personas de tu entorno realmente usan a diario.
          </p>
        </div>

        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-6">
          <span class="font-mono text-2xl font-bold text-indigo-400">02</span>
          <h3 class="mt-3 text-lg font-bold text-white">Sin trabas ni intermediarios</h3>
          <p class="mt-2 text-sm text-gray-400">
            Un banco de pruebas ágil donde si tienes una idea para resolver un problema de la carrera, puedes implementarla directamente.
          </p>
        </div>

        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-6">
          <span class="font-mono text-2xl font-bold text-blue-400">03</span>
          <h3 class="mt-3 text-lg font-bold text-white">Comunidad colaborativa</h3>
          <p class="mt-2 text-sm text-gray-400">
            El código queda disponible para que las siguientes generaciones de estudiantes lo amplíen, corrijan y mantengan vivo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE GUÍAS Y MINI CURSOS (INDEX) -->
<section id="guias" class="relative w-full overflow-hidden border-t border-white/10 px-6 py-16 md:px-10 lg:py-24">
  <!-- Luces ambientales difusas -->
  <div
    class="pointer-events-none absolute right-1/4 top-0 h-[380px] w-[500px] rounded-full bg-astra-400/10 blur-[140px]"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <!-- Encabezado de la sección -->
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end mb-12 sm:mb-16">
      <div class="max-w-2xl">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-astra-400/20 bg-astra-400/10 px-3.5 py-1 text-xs font-mono text-astra-400">
          <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"></span>
          KNOWLEDGE BASE
        </div>
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          Guías técnicas y <span class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent">mini cursos</span>
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-gray-400 sm:text-base">
          Material de apoyo para talleres prácticos, laboratorios y materias técnicas.</p>
      </div>

      <!-- Enlace / Botón a la página completa -->
      <a
        href="/guias"
        class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-5 py-2.5 text-xs font-semibold text-white transition-all hover:border-astra-400 hover:bg-white/10"
      >
        <span>Ver todas las guías</span>
        <span class="text-astra-400 transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
      
      <!-- TARJETA 1: LINUX (ACTIVA) -->
      <div class="group relative flex flex-col justify-between rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-astra-400/50 hover:shadow-[0_10px_35px_-10px_rgba(56,189,248,0.15)] sm:p-7">
        <div>
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-astra-400/30 bg-astra-400/10 text-astra-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-400">
              DISPONIBLE
            </span>
          </div>

          <h3 class="mt-5 text-lg font-bold text-white transition-colors group-hover:text-astra-400">
            Introducción a Linux & Servidores
          </h3>
          <p class="mt-2 text-xs leading-relaxed text-gray-400 sm:text-sm">
            Virtualización en VMware, instalación guiada de Debian GNOME, comandos CLI esenciales y despliegue de un servidor Apache.
          </p>

          <div class="mt-4 flex items-center gap-3 font-mono text-[11px] text-gray-400">
            <span class="text-astra-400">4 Horas</span>
            <span>•</span>
            <span>Taller Presencial</span>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/5">
          <a
            href="/guias/linux"
            class="inline-flex w-full items-center justify-center gap-1.5 rounded-xl bg-astra-400 px-4 py-2.5 text-xs font-bold text-space-950 transition-all hover:bg-sky-300"
          >
            Abrir guía del taller
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- TARJETA 2: GIT (PRÓXIMAMENTE) -->
      <div class="relative flex flex-col justify-between rounded-2xl border border-white/5 bg-space-900/30 p-6 backdrop-blur-xl sm:p-7">
        <div>
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-gray-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
              </svg>
            </div>
            <span class="rounded-full border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-300">
              PRÓXIMAMENTE
            </span>
          </div>

          <h3 class="mt-5 text-lg font-bold text-white">
            Git, GitHub & Flujos de Trabajo
          </h3>
          <p class="mt-2 text-xs leading-relaxed text-gray-400 sm:text-sm">
            Control de versiones para proyectos de clase: ramas sin miedo, resolución de conflictos cotidianos y Pull Requests.
          </p>

          <div class="mt-4 flex items-center gap-3 font-mono text-[11px] text-gray-500">
            <span>Terminal + Web</span>
            <span>•</span>
            <span class="text-amber-400/80">En redacción</span>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/5">
          <button
            disabled
            class="w-full cursor-not-allowed rounded-xl border border-white/10 bg-white/5 py-2.5 text-center text-xs font-medium text-gray-500"
          >
            En preparación
          </button>
        </div>
      </div>

      <!-- TARJETA 3: DESARROLLO WEB (PRÓXIMAMENTE) -->
      <div class="relative flex flex-col justify-between rounded-2xl border border-white/5 bg-space-900/30 p-6 backdrop-blur-xl sm:p-7">
        <div>
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-gray-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <span class="rounded-full border border-cosmic-400/20 bg-cosmic-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-cosmic-400">
              PRÓXIMAMENTE
            </span>
          </div>

          <h3 class="mt-5 text-lg font-bold text-white">
            Desarrollo Web & Despliegue
          </h3>
          <p class="mt-2 text-xs leading-relaxed text-gray-400 sm:text-sm">
            Bases de frontend y backend: contenido aún en planificación.
          </p>

          <div class="mt-4 flex items-center gap-3 font-mono text-[11px] text-gray-500">
            <span>Fullstack base</span>
            <span>•</span>
            <span class="text-cosmic-400/80">Planificando</span>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/5">
          <button
            disabled
            class="w-full cursor-not-allowed rounded-xl border border-white/10 bg-white/5 py-2.5 text-center text-xs font-medium text-gray-500"
          >
            En preparación
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

      <section
        id="torneos"
        class="relative w-full overflow-hidden border-t border-white/10 px-6 py-16 md:px-10 lg:py-24"
    >
        <!-- Resplandor de fondo -->
        <div
            class="pointer-events-none absolute left-1/2 top-0 h-[400px] w-full max-w-[600px] -translate-x-1/2 rounded-full bg-cosmic-500/10 blur-[130px]"
            aria-hidden="true"
        >
        </div>

        <div class="relative z-10 mx-auto max-w-7xl">
            <!-- Encabezado de la sección -->
            <div class="mb-12 text-center md:mb-16">
                <div
                    class="mb-4 inline-flex items-center gap-2 rounded-full border border-cosmic-500/30 bg-cosmic-500/10 px-3.5 py-1 text-xs font-mono text-cosmic-400"
                >
                    <span
                        class="h-1.5 w-1.5 rounded-full bg-cosmic-400 animate-pulse"
                    ></span>
                    LIGA EXPERIMENTAL
                </div>
                <h2
                    class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl"
                >
                    Participa en <span
                        class="bg-gradient-to-r from-astra-400 to-cosmic-400 bg-clip-text text-transparent"
                        >torneos de videojuegos</span
                    >
                </h2>
                <p
                    class="mx-auto mt-4 mb-6 max-w-2xl text-base text-gray-400 sm:text-lg"
                >
                    Compite con la comunidad, demuestra tu habilidad y gana
                    premios. Elige tu arena y asegura tu lugar en la próxima
                    edición.
                </p>
            </div>

            <!-- Grid de Tarjetas -->
            <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
                
                <!-- TARJETA 1: Super Smash Bros -->
                <div
                    class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-space-900/60 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-astra-400/50 hover:shadow-[0_10px_40px_-10px_rgba(56,189,248,0.15)]"
                >
                    <div class="relative h-48 w-full overflow-hidden bg-space-800">
                        <div class="absolute inset-0 z-10 bg-gradient-to-t from-space-900 to-transparent"></div>
                        <img
                            src="/img/super-smash-bros-ultimate.webp"
                            alt="Super Smash Bros Ultimate"
                            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        <div class="absolute right-3 top-3 z-20 rounded bg-space-950/80 px-2 py-1 font-mono text-[10px] font-bold text-emerald-400 backdrop-blur-md border border-emerald-500/20">
                            PRÓXIMAMENTE
                        </div>
                    </div>

                    <div class="flex flex-grow flex-col p-6">
                        <h3 class="text-xl font-bold text-white transition-colors group-hover:text-astra-400">
                            Super Smash Bros. Ultimate
                        </h3>
                        <p class="mt-2 flex-grow text-sm leading-relaxed text-gray-400">
                            Demuestra quién es el mejor en el escenario. Torneo 1v1 sin objetos, destino final, solo habilidad pura.
                        </p>

                        <div class="mb-6 mt-4 space-y-2 border-t border-white/5 pt-4">
                            <div class="flex items-center gap-2 text-xs text-gray-400">
                                <svg class="h-3.5 w-3.5 text-astra-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <span>Fecha por definir</span>
                            </div>
                            <div class="flex items-center gap-2 text-xs text-gray-400">
                                <svg class="h-3.5 w-3.5 text-cosmic-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                <span>Modalidad Presencial</span>
                            </div>
                        </div>

                        <a href="/registro-smash" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-white transition-all hover:border-astra-400 hover:bg-astra-400 hover:text-space-950">
                            Registrarme
                            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </a>
                    </div>
                </div>

                <!-- TARJETA 2: Mario Kart 8 -->
