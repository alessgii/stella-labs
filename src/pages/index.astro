---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import TerminalWorkspace from "../components/TerminalWorkspace.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="StellaLabs | Laboratorio Experimental">
  <Header />

  <!-- =======================================================================
       1. HERO SECTION
       ======================================================================= -->
  <main class="relative flex min-h-[calc(100vh-5rem)] items-center justify-center overflow-hidden px-6 py-16 md:px-10">
    <!-- Malla de puntos de fondo -->
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(#38bdf812_1px,transparent_1px)] [background-size:32px_32px]"
      aria-hidden="true"
    ></div>

    <!-- Resplandor ambiental estelar -->
    <div
      class="pointer-events-none absolute -top-40 right-1/4 h-[450px] w-[450px] rounded-full bg-astra-400/10 blur-[140px]"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Columna izquierda: Propuesta de valor -->
      <div class="flex flex-col items-center text-center lg:col-span-7 lg:items-start lg:text-left">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-astra-400/25 bg-astra-400/10 px-3.5 py-1 text-xs font-mono font-medium text-astra-400">
          <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"></span>
          Ingeniería en Teleinformática · CUCSur
        </div>

        <h1 class="max-w-2xl text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl lg:leading-[1.12]">
          El laboratorio de <span class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent">software y utilidades</span> hecho por y para estudiantes.
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-gray-300 md:text-lg">
          Un espacio donde convertimos ideas, proyectos de clase y necesidades del campus en herramientas reales, abiertas y listas para producción.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
          <Button href="#herramientas" variant="primary">Explorar herramientas</Button>
          <Button href="#proposito" variant="secondary">Conocer el proyecto</Button>
        </div>

        <a
          href="https://teleinformatica.stellalabs.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-12 inline-flex items-center gap-1.5 text-sm text-gray-400 underline underline-offset-4 transition-colors hover:text-white"
        >
          Visita el portal oficial de la carrera
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Columna derecha: Terminal Workspace pulida con controles de ventana -->
      <div class="hidden relative md:flex w-full justify-center lg:col-span-5 lg:justify-end">
        <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-space-900/80 p-5 shadow-[0_20px_50px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-300 hover:border-astra-400/30">
          <!-- Window Header con semáforo de consola -->
          <div class="mb-4 flex items-center justify-between border-b border-white/5 pb-3">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="font-mono text-xs text-gray-400">stellalabs-workspace.config</span>
            <span class="font-mono text-[10px] text-astra-400/80">sh</span>
          </div>

          <div class="w-full">
            <TerminalWorkspace />
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- =======================================================================
       2. PROPÓSITO & MANIFIESTO (Integración fluida de Acerca de + Pilares)
       ======================================================================= -->
  <section id="proposito" class="relative w-full overflow-hidden border-t border-white/10 px-6 py-20 md:px-10 lg:py-28">
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 h-[380px] w-[550px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cosmic-500/10 blur-[150px]"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-7xl">
      <!-- Manifiesto central -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-astra-400/25 bg-astra-400/10 px-3.5 py-1 text-xs font-mono text-astra-400">
          <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"></span>
          INICIATIVA INDEPENDIENTE
        </div>
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          ¿Por qué existe <span class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent">StellaLabs?</span>
        </h2>
        <p class="mt-5 text-base leading-relaxed text-gray-300 sm:text-lg">
          Muchos de los mejores proyectos universitarios se quedan olvidados en carpetas comprimidas al terminar el semestre. StellaLabs es el banco de pruebas experimental para transformar esas ideas en código útil, compartido y mantenido por la comunidad.
        </p>
      </div>

      <!-- Tarjetas de los 3 Pilares -->
      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-space-900/50 p-7 backdrop-blur-xl transition-all duration-300 hover:border-astra-400/30 hover:bg-space-900/80">
          <span class="font-mono text-2xl font-bold text-astra-400">01</span>
          <h3 class="mt-4 text-lg font-bold text-white">Salida a producción real</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Aprender a desplegar, orquestar y documentar software que estudiantes y profesores del entorno usan activamente en el día a día.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-space-900/50 p-7 backdrop-blur-xl transition-all duration-300 hover:border-cosmic-400/30 hover:bg-space-900/80">
          <span class="font-mono text-2xl font-bold text-cosmic-400">02</span>
          <h3 class="mt-4 text-lg font-bold text-white">Sin trabas ni burocracia</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Un laboratorio ágil donde cualquier idea viable para resolver dinámicas de la carrera puede pasar de prototipo a despliegue sin esperas.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-space-900/50 p-7 backdrop-blur-xl transition-all duration-300 hover:border-astra-400/30 hover:bg-space-900/80">
          <span class="font-mono text-2xl font-bold text-astra-300">03</span>
          <h3 class="mt-4 text-lg font-bold text-white">Comunidad colaborativa</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            El código se mantiene abierto para que las siguientes generaciones de estudiantes lo auditen, optimicen y continúen enriqueciendo.
          </p>
        </div>
      </div>

      <!-- Enlace a historia completa -->
      <div class="mt-10 flex justify-center">
        <a
          href="/acerca-de"
          class="group inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-astra-400 hover:text-white transition-colors"
        >
          <span>Conocer a fondo la historia y el equipo</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- =======================================================================
       3. BENTO GRID DE HERRAMIENTAS (100% Interactivo y navegable)
       ======================================================================= -->
  <section id="herramientas" class="relative w-full border-t border-white/10 px-6 py-20 md:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-14 text-center md:text-left">
        <span class="font-mono text-xs uppercase tracking-wider text-astra-400">Módulos en desarrollo</span>
        <h2 class="mt-2 text-3xl font-extrabold text-white sm:text-4xl">Lo que estamos construyendo</h2>
        <p class="mt-3 max-w-xl text-base text-gray-400">Herramientas concretas diseñadas para resolver dinámicas del campus y experimentar con arquitecturas modernas.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Bento 1: Eventos -->
        <a
          href="/eventos"
          class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-space-900/50 p-8 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-astra-400/40 hover:bg-space-900/80 hover:shadow-[0_12px_35px_-10px_rgba(56,189,248,0.2)]"
        >
          <div>
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl border border-astra-400/25 bg-astra-400/10 text-astra-400 transition-colors group-hover:border-astra-400/50">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white transition-colors group-hover:text-astra-400">Registro de Eventos</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">
              Plataforma dedicada a conferencias, talleres y convocatorias del campus sin depender de formularios dispersos.
            </p>
          </div>
          <div class="mt-8 flex items-center gap-2 font-mono text-xs font-medium text-astra-400">
            <span>Acceso habilitado</span>
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </div>
        </a>

        <!-- Bento 2: Sandbox & Juegos -->
        <a
          href="/juegos"
          class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-space-900/50 p-8 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-cosmic-400/40 hover:bg-space-900/80 hover:shadow-[0_12px_35px_-10px_rgba(192,132,252,0.2)]"
        >
          <div>
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl border border-cosmic-400/25 bg-cosmic-400/10 text-cosmic-400 transition-colors group-hover:border-cosmic-400/50">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white transition-colors group-hover:text-cosmic-400">Mini Juegos & Sandbox</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">
              Banco interactivo para poner a prueba algoritmos de lógica, inteligencia de tableros y dinámicas programadas por alumnos.
            </p>
          </div>
          <div class="mt-8 flex items-center gap-2 font-mono text-xs font-medium text-cosmic-400">
            <span>Módulos experimentales</span>
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </div>
        </a>

        <!-- Bento 3: APIs y Utilidades -->
        <a
          href="/herramientas"
          class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-space-900/50 p-8 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-astra-300/40 hover:bg-space-900/80 hover:shadow-[0_12px_35px_-10px_rgba(125,211,252,0.2)]"
        >
          <div>
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl border border-astra-300/25 bg-astra-300/10 text-astra-300 transition-colors group-hover:border-astra-300/50">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white transition-colors group-hover:text-astra-300">APIs & Microservicios</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">
              Endpoints, parsers de horarios y utilidades ligeras abiertas como base para nuevos proyectos de la facultad.
            </p>
          </div>
          <div class="mt-8 flex items-center gap-2 font-mono text-xs font-medium text-astra-300">
            <span>En fase de diseño</span>
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- =======================================================================
       4. GUÍAS TÉCNICAS Y KNOWLEDGE BASE
       ======================================================================= -->
  <section id="guias" class="relative w-full overflow-hidden border-t border-white/10 px-6 py-20 md:px-10 lg:py-24">
    <div
      class="pointer-events-none absolute right-1/4 top-0 h-[380px] w-[500px] rounded-full bg-astra-400/10 blur-[140px]"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-7xl">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end mb-12 sm:mb-16">
        <div class="max-w-2xl">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-astra-400/25 bg-astra-400/10 px-3.5 py-1 text-xs font-mono text-astra-400">
            <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"></span>
            KNOWLEDGE BASE
          </div>
          <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
            Guías técnicas y <span class="bg-gradient-to-r from-astra-400 via-sky-300 to-cosmic-400 bg-clip-text text-transparent">mini cursos</span>
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-gray-400 sm:text-base">
            Material de apoyo directo para talleres presenciales, laboratorios y materias técnicas.
          </p>
        </div>

        <a
          href="/guias"
          class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-5 py-2.5 text-xs font-semibold text-white transition-all hover:border-astra-400 hover:bg-white/10"
        >
          <span>Ver todas las guías</span>
          <span class="text-astra-400 transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- GUÍA 1: LINUX (ACTIVA) -->
        <div class="group relative flex flex-col justify-between rounded-2xl border border-white/10 bg-space-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-astra-400/50 hover:shadow-[0_10px_35px_-10px_rgba(56,189,248,0.2)] sm:p-7">
          <div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-astra-400/30 bg-astra-400/10 text-astra-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-400">
                DISPONIBLE
              </span>
            </div>

            <h3 class="mt-5 text-lg font-bold text-white transition-colors group-hover:text-astra-400">
              Introducción a Linux & Servidores
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-gray-400 sm:text-sm">
              Virtualización en VMware, instalación guiada de Debian GNOME, comandos CLI fundamentales y despliegue de un servidor Apache.
            </p>

            <div class="mt-4 flex items-center gap-3 font-mono text-[11px] text-gray-400">
              <span class="text-astra-400">4 Horas</span>
              <span>•</span>
              <span>Taller Presencial</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5">
            <a
              href="/guias/linux"
              class="inline-flex w-full items-center justify-center gap-1.5 rounded-xl bg-astra-400 px-4 py-2.5 text-xs font-bold text-space-950 transition-all hover:bg-astra-300"
            >
              Abrir guía del taller
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- GUÍA 2: GIT (PRÓXIMAMENTE) -->
        <div class="relative flex flex-col justify-between rounded-2xl border border-white/5 bg-space-900/30 p-6 backdrop-blur-xl sm:p-7">
          <div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-gray-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                </svg>
              </div>
              <span class="rounded-full border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-300">
                PRÓXIMAMENTE
              </span>
            </div>

            <h3 class="mt-5 text-lg font-bold text-white">
              Git, GitHub & Flujos de Trabajo
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-gray-400 sm:text-sm">
              Control de versiones para proyectos de equipo: ramas seguras, resolución de conflictos y flujo de Pull Requests.
            </p>

            <div class="mt-4 flex items-center gap-3 font-mono text-[11px] text-gray-500">
              <span>Terminal + Web</span>
              <span>•</span>
              <span class="text-amber-400/80">En redacción</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5">
            <button
              disabled
              class="w-full cursor-not-allowed rounded-xl border border-white/10 bg-white/5 py-2.5 text-center text-xs font-medium text-gray-500"
            >
              En preparación
            </button>
          </div>
        </div>

        <!-- GUÍA 3: DESARROLLO WEB (PRÓXIMAMENTE) -->
        <div class="relative flex flex-col justify-between rounded-2xl border border-white/5 bg-space-900/30 p-6 backdrop-blur-xl sm:p-7">
          <div>
            <div class="flex items-center justify-between border-b border-white/5 pb-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-gray-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <span class="rounded-full border border-cosmic-400/20 bg-cosmic-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-cosmic-400">
                PRÓXIMAMENTE
              </span>
            </div>

            <h3 class="mt-5 text-lg font-bold text-white">
              Desarrollo Web & Despliegue
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-gray-400 sm:text-sm">
              Fundamentos de frontend moderno, servicios API backend y despliegue continuo en entornos reales.
            </p>

            <div class="mt-4 flex items-center gap-3 font-mono text-[11px] text-gray-500">
              <span>Fullstack base</span>
              <span>•</span>
              <span class="text-cosmic-400/80">Planificando</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5">
            <button
              disabled
              class="w-full cursor-not-allowed rounded-xl border border-white/10 bg-white/5 py-2.5 text-center text-xs font-medium text-gray-500"
            >
              En preparación
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =======================================================================
       5. LIGA EXPERIMENTAL DE TORNEOS (Alineada y estilizada)
       ======================================================================= -->
  <section id="torneos" class="relative w-full overflow-hidden border-t border-white/10 px-6 py-20 md:px-10 lg:py-24">
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-[400px] w-full max-w-[600px] -translate-x-1/2 rounded-full bg-cosmic-500/10 blur-[140px]"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-7xl">
      <!-- Encabezado de Torneos -->
      <div class="mb-14 text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-cosmic-500/30 bg-cosmic-500/10 px-3.5 py-1 text-xs font-mono text-cosmic-400">
          <span class="h-1.5 w-1.5 rounded-full bg-cosmic-400 animate-pulse"></span>
          LIGA EXPERIMENTAL
        </div>
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
          Participa en <span class="bg-gradient-to-r from-astra-400 to-cosmic-400 bg-clip-text text-transparent">torneos de videojuegos</span>
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-gray-400 sm:text-lg">
          Compite con la comunidad del campus, pon a prueba tus reflejos y asegura tu lugar en la próxima edición presencial.
        </p>
      </div>

      <!-- Grid de Torneos -->
      <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- TORNEO 1: Smash -->
