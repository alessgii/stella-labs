---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getWorkshops } from "../../lib/workshops";

// 1. Obtención pública de talleres en el servidor
const { data: workshopsResponse, error: workshopsError } = await getWorkshops();
const workshops = workshopsResponse ?? [];

// Helpers de fechas y badges
const now = new Date();

const getBadgeStyle = (status: string, isFull: boolean, isExpired: boolean) => {
  if (isExpired || status === 'finalizado') {
    return { text: 'Finalizado', class: 'border-slate-500/20 bg-slate-500/10 text-slate-400' };
  }
  if (isFull) {
    return { text: 'Cupo Lleno', class: 'border-rose-500/20 bg-rose-500/10 text-rose-400' };
  }
  if (status === 'registro_abierto') {
    return { text: 'Registro Abierto', class: 'border-emerald-500/25 bg-emerald-500/15 text-emerald-400 animate-pulse' };
  }
  if (status === 'proximamente') {
    return { text: 'Próximamente', class: 'border-amber-500/20 bg-amber-500/10 text-amber-300' };
  }
  return { text: status, class: 'border-slate-500/20 bg-slate-500/10 text-slate-300' };
};
---

<Layout title="Laboratorios y Talleres | StellaLabs">
  <Header />

 <main class="relative min-h-screen pb-20 pt-20 sm:pt-24">
    <!-- Fondos y Glows -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(rgba(56,189,248,0.04)_1px,transparent_1px)] [background-size:32px_32px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-40 left-1/4 h-[400px] w-[400px] rounded-full bg-[var(--color-astra-500)]/10 blur-[120px]" aria-hidden="true"></div>

    <!-- Toast de Notificación -->
    <div id="toast-notification" class="fixed bottom-5 right-5 z-50 hidden max-w-sm rounded-xl border border-[var(--color-glass-edge)] bg-[var(--color-space-950)]/95 p-4 shadow-2xl backdrop-blur-md transition-all duration-300">
      <div class="flex items-start gap-3">
        <div id="toast-icon" class="mt-0.5 text-lg"></div>
        <div>
          <h4 id="toast-title" class="font-sans text-sm font-semibold text-white"></h4>
          <p id="toast-message" class="mt-1 font-sans text-xs text-[#9da7ba]"></p>
        </div>
      </div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 md:px-10">

  <div class="mb-12 text-center md:text-left">
  <!-- Badges en línea -->
  <div class="mb-3 flex flex-wrap items-center justify-center md:justify-start gap-2">
    <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-astra-400)]/20 bg-[var(--color-astra-400)]/10 px-3 py-0.5 font-mono text-[11px] font-medium tracking-[0.10em] text-[var(--color-astra-300)] uppercase">
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-astra-400)] animate-pulse"></span>
      KNOWLEDGE BASE & LABS
    </div>

    <div class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-0.5 font-mono text-[10px] font-medium tracking-wider text-amber-300 uppercase">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-amber-400"></span>
      </span>
      Fase Beta
    </div>
  </div>

  <h1 class="font-sans text-4xl font-medium tracking-tight text-white sm:text-5xl">
    Únete a nuestros <span class="bg-gradient-to-r from-[var(--color-astra-400)] to-[var(--color-cosmic-400)] bg-clip-text text-transparent">cursos y talleres</span>
  </h1>
  <p class="mt-3 max-w-2xl font-sans text-base leading-relaxed text-[#9da7ba] md:text-lg">
    Aprende nuevas habilidades técnicas impartidas por los miembros de StellaLabs. Espacios diseñados para experimentar, programar y construir en el CUCSur.
  </p>
</div>

      <!-- GRID DE TALLERES DINÁMICO -->
      {workshopsError ? (
        <div class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-6 text-center text-rose-300">
          Error al cargar la lista de talleres. Por favor intenta recargar la página.
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {workshops.map((workshop) => {
            const totalReg = workshop.total_registered || 0;
            const isFull = totalReg >= workshop.max_capacity;
            const regStarts = new Date(workshop.register_starts_at);
            const regEnds = new Date(workshop.register_ends_at);
            const isExpired = now > regEnds;
            const badge = getBadgeStyle(workshop.status, isFull, isExpired);

            return (
              <div class="group flex flex-col justify-between rounded-[var(--radius-card)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-7 shadow-[var(--shadow-glass-card)] backdrop-blur-md transition-all hover:border-[var(--color-glass-edge-hover)]">
                <div>
                  <div class="mb-4 flex items-center justify-between border-b border-[var(--color-glass-edge)] pb-4">
                    <div class="flex h-10 w-10 items-center justify-center rounded-[var(--radius-input)] border border-[var(--color-astra-400)]/30 bg-[var(--color-astra-400)]/10 text-[var(--color-astra-400)]">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                      </svg>
                    </div>
                    <span class={`rounded-[var(--radius-badge)] border px-2 py-0.5 font-mono text-[10px] font-medium tracking-wider uppercase ${badge.class}`}>
                      {badge.text}
                    </span>
                  </div>

                  <h3 class="font-sans text-xl font-medium text-white transition-colors group-hover:text-[var(--color-astra-400)]">
                    {workshop.title}
                  </h3>
                  <p class="mt-2 line-clamp-3 font-sans text-sm text-[#9da7ba]">
                    {workshop.description}
                  </p>

                  <ul class="mt-4 space-y-1.5 font-mono text-xs text-[#9da7ba]">
                    <li><span class="text-white">Día:</span> {workshop.day_of_week}</li>
                    <li><span class="text-white">Hora:</span> {workshop.start_time?.slice(0, 5)} hrs</li>
                    <li><span class="text-white">Aula:</span> {workshop.classroom}</li>
                    <li class="pt-1">
                      <div class="flex items-center justify-between text-[11px]">
                        <span class="text-white">Cupo disponible:</span>
                        <span class={isFull ? 'text-rose-400 font-bold' : 'text-[var(--color-astra-300)] font-bold'}>
                          {totalReg} / {workshop.max_capacity}
                        </span>
                      </div>
                      <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
                        <div 
                          class={`h-full transition-all ${isFull ? 'bg-rose-500' : 'bg-[var(--color-astra-400)]'}`} 
                          style={`width: ${Math.min(100, (totalReg / workshop.max_capacity) * 100)}%`}
                        ></div>
                      </div>
                    </li>
                  </ul>
                </div>

                <button 
                  data-modal={`modal-${workshop.id}`} 
                  class="mt-6 w-full rounded-full border border-[var(--color-glass-edge)] bg-white/[0.04] py-2.5 font-mono text-xs font-medium uppercase tracking-wider text-white transition-all hover:bg-[var(--color-astra-500)] hover:border-[var(--color-astra-400)] hover:text-black"
                >
                  Ver detalles
                </button>
              </div>
            );
          })}
        </div>
      )}

      <!-- CALL TO ACTION - PROPUESTAS -->
      <div class="mt-24 rounded-[var(--radius-modal)] border border-[var(--color-glass-edge)] bg-[var(--color-glass-surface)] p-8 text-center shadow-[var(--shadow-glass-card)] backdrop-blur-xl sm:p-14 relative overflow-hidden">
        <div class="pointer-events-none absolute -bottom-20 -right-20 h-40 w-40 rounded-full bg-[var(--color-astra-500)]/20 blur-[80px]" aria-hidden="true"></div>
        <div class="relative z-10">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[var(--color-astra-400)]/20 bg-[var(--color-astra-400)]/10 px-3 py-1 font-mono text-[11px] tracking-[0.10em] uppercase text-[var(--color-astra-300)]">
            ESPACIO ABIERTO
          </div>
          <h2 class="font-sans text-2xl font-medium text-white sm:text-3xl">¿Quieres proponer un curso o taller?</h2>
          <p class="mx-auto mt-4 max-w-xl font-sans text-sm leading-relaxed text-[#9da7ba] sm:text-base">
            Si dominas un tema, herramienta o tecnología y quieres compartirlo con la comunidad del CUCSur, StellaLabs te ayuda a organizar el espacio.
          </p>
          <div class="mt-8 flex justify-center">
            <a href="/contacto" class="inline-flex items-center gap-2 rounded-full border border-transparent bg-[var(--color-astra-500)] px-6 py-3 font-mono text-xs font-medium uppercase tracking-wider text-black transition-all hover:bg-[var(--color-astra-400)] hover:shadow-[var(--shadow-glow-astra)]">
              Enviar propuesta
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- MODALES DINÁMICOS -->
  {workshops.map((workshop) => {
    const totalReg = workshop.total_registered || 0;
    const isFull = totalReg >= workshop.max_capacity;
    const regStarts = new Date(workshop.register_starts_at);
    const regEnds = new Date(workshop.register_ends_at);
    const isExpired = now > regEnds;
    const notStarted = now < regStarts;
    const isOpen = workshop.status === 'registro_abierto';

    return (
      <dialog id={`modal-${workshop.id}`} class="bg-transparent p-0 m-auto backdrop:bg-black/60 backdrop:backdrop-blur-sm open:animate-in open:fade-in open:zoom-in-95">
        <div 
          class="relative w-full max-w-md rounded-[var(--radius-modal)] border border-[var(--color-glass-edge)] bg-[var(--color-space-950)] p-6 shadow-[var(--shadow-glow-astra)] text-left m-4"
          data-workshop-modal-id={workshop.id}
          data-is-full={isFull ? 'true' : 'false'}
          data-is-expired={isExpired ? 'true' : 'false'}
          data-not-started={notStarted ? 'true' : 'false'}
          data-is-open={isOpen ? 'true' : 'false'}
        >
          <h3 class="text-2xl font-medium text-white font-sans">{workshop.title}</h3>
          
          <div class="mt-4 space-y-3 font-sans text-sm text-[#9da7ba]">
            <p>{workshop.description}</p>
            <div class="rounded-[var(--radius-input)] bg-white/5 p-4 border border-[var(--color-glass-edge)]">
              <ul class="font-mono text-xs space-y-2">
                <li><span class="text-[var(--color-astra-400)]">Día:</span> {workshop.day_of_week}</li>
                <li><span class="text-[var(--color-astra-400)]">Horario:</span> {workshop.start_time?.slice(0, 5)} hrs</li>
                <li><span class="text-[var(--color-astra-400)]">Lugar:</span> Aula {workshop.classroom}</li>
                <li><span class="text-[var(--color-astra-400)]">Modalidad:</span> {workshop.modality}</li>
                <li><span class="text-[var(--color-astra-400)]">Cupo máximo:</span> {workshop.max_capacity} alumnos</li>
                <li><span class="text-[var(--color-astra-400)]">Límite registro:</span> 23 de octubre, 23:59 hrs</li>
              </ul>
            </div>
          </div>

          <div class="mt-6 flex justify-end gap-3">
            <button class="close-modal rounded-full px-4 py-2 font-mono text-xs text-[#9da7ba] hover:text-white transition-colors">
              Cerrar
            </button>
            
            <!-- Contenedor dinámico de botón de acción (se actualiza vía cliente) -->
            <div id={`action-container-${workshop.id}`}>
              {isFull ? (
                <button disabled class="cursor-not-allowed rounded-full bg-white/10 px-5 py-2 font-mono text-xs font-medium uppercase tracking-wider text-white/50 border border-white/5">
                  Cupo Lleno
                </button>
              ) : isExpired ? (
                <button disabled class="cursor-not-allowed rounded-full bg-white/10 px-5 py-2 font-mono text-xs font-medium uppercase tracking-wider text-white/50 border border-white/5">
                  Registro Cerrado
                </button>
              ) : notStarted ? (
                <button disabled class="cursor-not-allowed rounded-full bg-white/10 px-5 py-2 font-mono text-xs font-medium uppercase tracking-wider text-white/50 border border-white/5">
                  Próximamente
                </button>
              ) : (
                <a href="/login" class="rounded-full bg-[var(--color-astra-500)] px-5 py-2 font-mono text-xs font-medium uppercase tracking-wider text-black hover:bg-[var(--color-astra-400)] transition-all inline-block">
                  Iniciar sesión para registrarme
                </a>
              )}
            </div>
          </div>
        </div>
      </dialog>
    );
  })}

  <Footer />
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  document.addEventListener('DOMContentLoaded', async () => {
    const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-modal]');
    const closeButtons = document.querySelectorAll<HTMLButtonElement>('.close-modal');

    function showToast(title: string, message: string, isError = false) {
      const toast = document.getElementById('toast-notification');
      const toastTitle = document.getElementById('toast-title');
      const toastMessage = document.getElementById('toast-message');
      const toastIcon = document.getElementById('toast-icon');

      if (!toast || !toastTitle || !toastMessage || !toastIcon) return;

      toastTitle.textContent = title;
      toastMessage.textContent = message;
      toastIcon.textContent = isError ? '❌' : '🎉';

      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 4000);
    }

    // Modal Controlers
    openButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const modalId = btn.getAttribute('data-modal');
        if (modalId) {
          const dialog = document.getElementById(modalId) as HTMLDialogElement | null;
          dialog?.showModal();
        }
      });
    });

    closeButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const dialog = target?.closest('dialog') as HTMLDialogElement | null;
        dialog?.close();
      });
    });

    document.querySelectorAll<HTMLDialogElement>('dialog').forEach(dialog => {
      dialog.addEventListener('click', (e) => {
        const dialogDimensions = dialog.getBoundingClientRect();
        if (
          e.clientX < dialogDimensions.left ||
          e.clientX > dialogDimensions.right ||
          e.clientY < dialogDimensions.top ||
          e.clientY > dialogDimensions.bottom
        ) {
          dialog.close();
        }
      });
    });

    // Función para procesar la petición de registro AJAX
    function attachRegisterHandler(button: HTMLButtonElement) {
      button.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement | null;
        if (!target) return;

        const workshopId = target.getAttribute('data-workshop-id');
        const btnText = target.querySelector<HTMLElement>('.btn-text');
        const btnSpinner = target.querySelector<HTMLElement>('.btn-spinner');

        if (!workshopId) return;

        target.disabled = true;
        if (btnText) btnText.textContent = 'Procesando...';
        if (btnSpinner) btnSpinner.classList.remove('hidden');

        try {
          const response = await fetch('/api/workshops/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ workshopId }),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || 'Error al procesar la inscripción');
          }

          showToast('Inscripción exitosa', 'Te has registrado correctamente al taller.');
          
          const dialog = target.closest('dialog') as HTMLDialogElement | null;
          dialog?.close();

          setTimeout(() => window.location.reload(), 1200);

        } catch (err: any) {
          showToast('Error de registro', err.message || 'Ocurrió un fallo inesperado', true);
          target.disabled = false;
          if (btnText) btnText.textContent = 'Registrarme';
          if (btnSpinner) btnSpinner.classList.add('hidden');
        }
      });
    }

    // VERIFICACIÓN DE SESIÓN EN CLIENTE (Sincronización dinámica de botones)
    const { data: { session } } = await supabase.auth.getSession();

    if (session?.user) {
      // Obtener inscripciones previas del usuario autenticado
      const { data: regs } = await supabase
        .from('workshops_registrations')
        .select('workshop_id')
        .eq('user_id', session.user.id);

      const userRegistrations = (regs || []).map(r => r.workshop_id);

      // Actualizar dinámicamente cada modal de taller
      document.querySelectorAll<HTMLElement>('[data-workshop-modal-id]').forEach(modalCard => {
        const workshopId = modalCard.getAttribute('data-workshop-modal-id');
        const isFull = modalCard.getAttribute('data-is-full') === 'true';
        const isExpired = modalCard.getAttribute('data-is-expired') === 'true';
        const notStarted = modalCard.getAttribute('data-not-started') === 'true';
        const isOpen = modalCard.getAttribute('data-is-open') === 'true';

        if (!workshopId) return;

        const actionContainer = document.getElementById(`action-container-${workshopId}`);
        if (!actionContainer) return;

        if (userRegistrations.includes(workshopId)) {
          actionContainer.innerHTML = `
            <button disabled class="rounded-full bg-emerald-500/20 border border-emerald-500/30 px-5 py-2 font-mono text-xs font-medium uppercase tracking-wider text-emerald-400 cursor-default">
              ✓ Ya estás inscrito
            </button>
          `;
        } else if (isOpen && !isFull && !isExpired && !notStarted) {
          actionContainer.innerHTML = `
            <button 
              data-register-btn 
              data-workshop-id="${workshopId}" 
              class="btn-register rounded-full bg-[var(--color-astra-500)] px-5 py-2 font-mono text-xs font-medium uppercase tracking-wider text-black hover:bg-[var(--color-astra-400)] hover:shadow-[var(--shadow-glow-astra)] transition-all flex items-center gap-2"
            >
              <span class="btn-text">Registrarme</span>
              <span class="btn-spinner hidden h-3.5 w-3.5 animate-spin rounded-full border-2 border-black border-t-transparent"></span>
            </button>
          `;

          const newBtn = actionContainer.querySelector<HTMLButtonElement>('.btn-register');
          if (newBtn) attachRegisterHandler(newBtn);
        }
      });
    }
  });
</script>