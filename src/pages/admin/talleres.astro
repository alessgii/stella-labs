---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Administración de Talleres | StellaLabs">
  <Header />

  <main class="relative min-h-[calc(100vh-5rem)] px-4 py-10 md:px-10 overflow-x-hidden">
    <div
      class="pointer-events-none absolute -left-28 top-1/4 h-[400px] w-[400px] rounded-full bg-cosmic-500/10 blur-[150px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-28 bottom-1/4 h-[400px] w-[400px] rounded-full bg-astra-500/10 blur-[150px]"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-7xl">
      <!-- Encabezado de la Sección -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-white/10 pb-6 mb-8">
        <div>
          <div class="mb-2 inline-flex items-center gap-2 rounded-full border border-astra-400/30 bg-astra-500/10 px-3 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-astra-300">
            <span class="h-1.5 w-1.5 rounded-full bg-astra-400 animate-pulse"></span>
            SYS_ADMIN // WORKSHOPS_CONTROL
          </div>
          <h1 class="font-sans text-2xl font-bold tracking-tight text-white sm:text-3xl">
            Gestión de Talleres
          </h1>
          <p class="mt-1 font-sans text-xs text-[#9da7ba] sm:text-sm">
            Crea nuevas sesiones y supervisa las listas de alumnos registrados y asistencia.
          </p>
        </div>

        <button
          type="button"
          id="btn-open-create-modal"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-astra-500 to-cosmic-600 px-5 py-2.5 font-sans text-xs font-semibold tracking-wide text-white shadow-[var(--shadow-glow-astra)] transition-all hover:brightness-110 active:scale-95"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Crear Nuevo Taller
        </button>
      </div>

      <!-- Tarjetas de Métricas Rápidas -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 mb-8">
        <div class="rounded-[var(--radius-card,16px)] border border-white/10 bg-[rgba(13,10,28,0.7)] p-4 shadow-[var(--shadow-glass-card)] backdrop-blur-xl">
          <p class="font-mono text-xs text-[#9da7ba]">Talleres Totales</p>
          <p id="metric-total-workshops" class="mt-1 font-sans text-2xl font-bold text-white">--</p>
        </div>
        <div class="rounded-[var(--radius-card,16px)] border border-white/10 bg-[rgba(13,10,28,0.7)] p-4 shadow-[var(--shadow-glass-card)] backdrop-blur-xl">
          <p class="font-mono text-xs text-[#9da7ba]">Inscripciones Totales</p>
          <p id="metric-total-attendances" class="mt-1 font-sans text-2xl font-bold text-astra-400">--</p>
        </div>
        <div class="rounded-[var(--radius-card,16px)] border border-white/10 bg-[rgba(13,10,28,0.7)] p-4 shadow-[var(--shadow-glass-card)] backdrop-blur-xl">
          <p class="font-mono text-xs text-[#9da7ba]">Asistencia Confirmada</p>
          <p id="metric-total-confirmed" class="mt-1 font-sans text-2xl font-bold text-emerald-400">--</p>
        </div>
      </div>

      <!-- Tabla / Lista de Talleres -->
      <div class="rounded-[var(--radius-card,16px)] border border-white/10 bg-[rgba(13,10,28,0.85)] p-5 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl">
        <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
          <h2 class="font-sans text-base font-semibold text-white">Listado de Talleres</h2>
          <span id="loading-indicator" class="font-mono text-xs text-astra-300 animate-pulse">Cargando datos...</span>
        </div>

        <div class="overflow-x-auto mt-4">
          <table class="w-full text-left font-sans text-xs">
            <thead>
              <tr class="border-b border-white/[0.08] font-mono text-[11px] text-[#9da7ba] uppercase tracking-wider">
                <th class="pb-3 pr-4">Taller / Instructor</th>
                <th class="pb-3 px-4">Modalidad</th>
                <th class="pb-3 px-4">Fecha & Hora</th>
                <th class="pb-3 px-4">Cupo / Registros</th>
                <th class="pb-3 px-4">Estado</th>
                <th class="pb-3 pl-4 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="workshops-table-body" class="divide-y divide-white/[0.04]">
              <!-- Filas inyectadas con JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <!-- MODAL: CREAR NUEVO TALLER -->
  <div
    id="modal-create-workshop"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
  >
    <div id="modal-create-backdrop" class="fixed inset-0 bg-space-950/80 backdrop-blur-md"></div>
    <div class="relative z-10 w-full max-w-2xl rounded-[var(--radius-modal,20px)] border border-white/10 bg-[rgba(13,10,28,0.95)] p-6 sm:p-7 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl">
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
        <h3 class="font-sans text-lg font-semibold text-white">Nuevo Taller Tecnológico</h3>
        <button type="button" id="btn-close-create-modal" class="text-[#9da7ba] hover:text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="form-create-workshop" class="space-y-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Título del Taller *</label>
            <input
              type="text"
              name="title"
              id="input-title"
              required
              placeholder="Ej. Taller de Microcontroladores ESP32"
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 text-xs text-white placeholder-[#9da7ba]/40 focus:border-astra-400 focus:outline-none"
            />
          </div>
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Slug URL *</label>
            <input
              type="text"
              name="slug"
              id="input-slug"
              required
              placeholder="taller-esp32-udg"
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 font-mono text-xs text-white placeholder-[#9da7ba]/40 focus:border-astra-400 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block font-mono text-xs text-[#9da7ba] mb-1">Descripción</label>
          <textarea
            name="description"
            rows="2"
            placeholder="Objetivo del taller, requerimientos previos, software necesario..."
            class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 text-xs text-white placeholder-[#9da7ba]/40 focus:border-astra-400 focus:outline-none"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Instructor *</label>
            <input
              type="text"
              name="instructor_name"
              required
              placeholder="Nombre del ponente"
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 text-xs text-white focus:border-astra-400 focus:outline-none"
            />
          </div>
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Modalidad *</label>
            <select
              name="modality"
              required
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/90 px-3 py-2 text-xs text-white focus:border-astra-400 focus:outline-none"
            >
              <option value="presencial">Presencial</option>
              <option value="virtual">Virtual</option>
              <option value="hibrido">Híbrido</option>
            </select>
          </div>
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Ubicación / Enlace *</label>
            <input
              type="text"
              name="location"
              required
              placeholder="Lab de Telemática / Google Meet"
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 text-xs text-white focus:border-astra-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Fecha *</label>
            <input
              type="date"
              name="start_date"
              required
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 text-xs text-white focus:border-astra-400 focus:outline-none"
            />
          </div>
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Hora Inicio *</label>
            <input
              type="time"
              name="start_time"
              required
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 text-xs text-white focus:border-astra-400 focus:outline-none"
            />
          </div>
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Duración (Horas) *</label>
            <input
              type="number"
              step="0.5"
              min="0.5"
              value="2"
              name="duration_hours"
              required
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 text-xs text-white focus:border-astra-400 focus:outline-none"
            />
          </div>
          <div>
            <label class="block font-mono text-xs text-[#9da7ba] mb-1">Cupo Máximo *</label>
            <input
              type="number"
              name="max_capacity"
              min="1"
              value="25"
              required
              class="w-full rounded-[var(--radius-input,8px)] border border-white/10 bg-space-950/70 px-3 py-2 text-xs text-white focus:border-astra-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-white/10">
          <button
            type="button"
            id="btn-cancel-create"
            class="rounded-full border border-white/10 px-4 py-2 font-sans text-xs text-[#9da7ba] hover:text-white"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="btn-submit-workshop"
            class="rounded-full bg-gradient-to-r from-astra-500 to-cosmic-600 px-5 py-2 font-sans text-xs font-semibold text-white shadow-md hover:brightness-110 disabled:opacity-50"
          >
            Guardar Taller
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: VER ALUMNOS INSCRITOS -->
  <div
    id="modal-attendees"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
  >
    <div id="modal-attendees-backdrop" class="fixed inset-0 bg-space-950/80 backdrop-blur-md"></div>
    <div class="relative z-10 w-full max-w-3xl rounded-[var(--radius-modal,20px)] border border-white/10 bg-[rgba(13,10,28,0.96)] p-6 shadow-[var(--shadow-glass-card)] backdrop-blur-2xl">
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
        <div>
          <h3 id="attendees-modal-title" class="font-sans text-base font-semibold text-white">Alumnos Inscritos</h3>
          <p id="attendees-modal-subtitle" class="font-mono text-xs text-[#9da7ba]">Cargando participantes...</p>
        </div>
        <button type="button" id="btn-close-attendees-modal" class="text-[#9da7ba] hover:text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="max-h-[60vh] overflow-y-auto">
        <table class="w-full text-left font-sans text-xs">
          <thead>
            <tr class="border-b border-white/[0.08] font-mono text-[11px] text-[#9da7ba] uppercase tracking-wider">
              <th class="pb-2.5">Código</th>
              <th class="pb-2.5">Nombre Completo</th>
              <th class="pb-2.5">Alias</th>
              <th class="pb-2.5">Carrera</th>
              <th class="pb-2.5 text-center">Asistió</th>
            </tr>
          </thead>
          <tbody id="attendees-table-body" class="divide-y divide-white/[0.04]">
            <!-- Filas inyectadas con JS -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  // 1. Verificación estricta de Rol de Administrador
  const checkAdminAuth = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) {
      window.location.href = "/login";
      return false;
    }

    const { data: profile } = await supabase
      .from("profiles")
      .select("role")
      .eq("id", session.user.id)
      .single();

    if (profile?.role !== "admin") {
      alert("Acceso denegado: Se requieren permisos de administrador.");
      window.location.href = "/";
      return false;
    }

    return true;
  };

  const tableBody = document.getElementById("workshops-table-body");
  const loadingIndicator = document.getElementById("loading-indicator");
  const metricWorkshops = document.getElementById("metric-total-workshops");
  const metricAttendances = document.getElementById("metric-total-attendances");
  const metricConfirmed = document.getElementById("metric-total-confirmed");

  // 2. Consulta y Render de Talleres con conteo relacional
  const loadWorkshops = async () => {
    if (!loadingIndicator) return;
    loadingIndicator.classList.remove("hidden");

    // Consulta con conteo de inscritos embebido vía FK workshop_attendances
    const { data: workshops, error } = await supabase
      .from("workshops")
      .select(`
        id,
        title,
        slug,
        instructor_name,
        modality,
        location,
        start_date,
        start_time,
        max_capacity,
        status,
        workshop_attendances(count)
      `)
      .order("start_date", { ascending: false });

    loadingIndicator.classList.add("hidden");

    if (error) {
      console.error("Error al cargar talleres:", error);
      return;
    }

    // Calcular Métricas
    let totalInscritos = 0;
    workshops.forEach((w: any) => {
      const count = w.workshop_attendances?.[0]?.count || 0;
      totalInscritos += count;
    });

    if (metricWorkshops) metricWorkshops.textContent = workshops.length.toString();
    if (metricAttendances) metricAttendances.textContent = totalInscritos.toString();

    // Consultar total asistencias confirmadas
    const { count: confirmedCount } = await supabase
      .from("workshop_attendances")
      .select("*", { count: "exact", head: true })
      .eq("attended", true);
    if (metricConfirmed) metricConfirmed.textContent = (confirmedCount || 0).toString();

    // Render Tabla
    if (!tableBody) return;
    tableBody.innerHTML = "";

    if (workshops.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-6 text-center text-[#9da7ba]">No se han registrado talleres todavía.</td>
        </tr>
      `;
      return;
    }

    workshops.forEach((w: any) => {
      const inscritos = w.workshop_attendances?.[0]?.count || 0;
      const pct = Math.round((inscritos / (w.max_capacity || 1)) * 100);

      const row = document.createElement("tr");
      row.className = "hover:bg-white/[0.02] transition-colors";
      row.innerHTML = `
        <td class="py-3.5 pr-4">
          <p class="font-medium text-white">${w.title}</p>
          <p class="font-mono text-[10px] text-[#9da7ba]">Prof. ${w.instructor_name || "Por definir"}</p>
        </td>
        <td class="py-3.5 px-4 font-mono text-[11px] capitalize text-[#d1e4fa]">
          ${w.modality}
        </td>
        <td class="py-3.5 px-4">
          <p class="font-mono text-[11px] text-[#d1e4fa]">${w.start_date}</p>
          <p class="font-mono text-[10px] text-[#9da7ba]">${w.start_time?.slice(0, 5)} hrs</p>
        </td>
        <td class="py-3.5 px-4">
          <div class="flex items-center gap-2">
            <span class="font-mono text-[11px] font-semibold ${inscritos >= w.max_capacity ? 'text-rose-400' : 'text-astra-300'}">
              ${inscritos} / ${w.max_capacity}
            </span>
            <span class="font-mono text-[10px] text-[#9da7ba]">(${pct}%)</span>
          </div>
        </td>
        <td class="py-3.5 px-4">
          <span class="rounded-full px-2 py-0.5 font-mono text-[10px] uppercase ${
            w.status === 'published'
              ? 'border border-emerald-500/30 bg-emerald-500/10 text-emerald-400'
              : 'border border-amber-500/30 bg-amber-500/10 text-amber-300'
          }">
            ${w.status || 'draft'}
          </span>
        </td>
        <td class="py-3.5 pl-4 text-right">
          <button
            type="button"
            data-workshop-id="${w.id}"
            data-workshop-title="${w.title}"
            class="btn-view-attendees inline-flex items-center gap-1.5 rounded-full border border-astra-400/30 bg-astra-500/10 px-3 py-1 font-mono text-[10px] text-astra-300 transition-colors hover:bg-astra-500/20"
          >
            Ver inscritos
          </button>
        </td>
      `;
      tableBody.appendChild(row);
    });

    // Enlazar botones para abrir el detalle de inscritos
    document.querySelectorAll(".btn-view-attendees").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute("data-workshop-id");
        const title = target.getAttribute("data-workshop-title");
        if (id && title) openAttendeesModal(id, title);
      });
    });
  };

  // 3. Modal de Creación
  const modalCreate = document.getElementById("modal-create-workshop");
  const btnOpenCreate = document.getElementById("btn-open-create-modal");
  const btnCloseCreate = document.getElementById("btn-close-create-modal");
  const btnCancelCreate = document.getElementById("btn-cancel-create");
  const formCreate = document.getElementById("form-create-workshop") as HTMLFormElement;
  const inputTitle = document.getElementById("input-title") as HTMLInputElement;
  const inputSlug = document.getElementById("input-slug") as HTMLInputElement;

  btnOpenCreate?.addEventListener("click", () => modalCreate?.classList.remove("hidden", "opacity-0"));
  const closeCreateModal = () => modalCreate?.classList.add("hidden");
  btnCloseCreate?.addEventListener("click", closeCreateModal);
  btnCancelCreate?.addEventListener("click", closeCreateModal);

  // Auto-slug a partir del título
  inputTitle?.addEventListener("input", () => {
    inputSlug.value = inputTitle.value
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-");
  });

  formCreate?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btnSubmit = document.getElementById("btn-submit-workshop") as HTMLButtonElement;
    btnSubmit.disabled = true;

    const fd = new FormData(formCreate);
    const newWorkshop = {
      title: String(fd.get("title")),
      slug: String(fd.get("slug")),
      description: String(fd.get("description")),
      instructor_name: String(fd.get("instructor_name")),
      modality: String(fd.get("modality")),
      location: String(fd.get("location")),
      start_date: String(fd.get("start_date")),
      start_time: String(fd.get("start_time")),
      duration_hours: Number(fd.get("duration_hours")),
      max_capacity: Number(fd.get("max_capacity")),
      status: "published",
    };

    const { error } = await supabase.from("workshops").insert([newWorkshop]);

    btnSubmit.disabled = false;
    if (error) {
      alert("Error al crear el taller: " + error.message);
      return;
    }

    formCreate.reset();
    closeCreateModal();
    loadWorkshops();
  });

  // 4. Modal de Alumnos Inscritos y Asistencia
  const modalAttendees = document.getElementById("modal-attendees");
  const btnCloseAttendees = document.getElementById("btn-close-attendees-modal");
  const attendeesTitle = document.getElementById("attendees-modal-title");
  const attendeesSubtitle = document.getElementById("attendees-modal-subtitle");
  const attendeesTableBody = document.getElementById("attendees-table-body");

  const closeAttendeesModal = () => modalAttendees?.classList.add("hidden");
  btnCloseAttendees?.addEventListener("click", closeAttendeesModal);

  const openAttendeesModal = async (workshopId: string, title: string) => {
    if (!modalAttendees || !attendeesTitle || !attendeesSubtitle || !attendeesTableBody) return;

    attendeesTitle.textContent = title;
    attendeesSubtitle.textContent = "Consultando base de datos...";
    attendeesTableBody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-[#9da7ba]">Cargando...</td></tr>`;
    modalAttendees.classList.remove("hidden");

    // Consulta de inscritos haciendo JOIN con profiles
    const { data: attendances, error } = await supabase
      .from("workshop_attendances")
      .select(`
        id,
        attended,
        registered_at,
        profiles (
          student_code,
          first_name,
          last_name,
          username,
          career
        )
      `)
      .eq("workshop_id", workshopId)
      .order("registered_at", { ascending: true });

    if (error) {
      attendeesTableBody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-rose-400">Error: ${error.message}</td></tr>`;
      return;
    }

    attendeesSubtitle.textContent = `${attendances.length} alumno(s) inscritos`;
    attendeesTableBody.innerHTML = "";

    if (attendances.length === 0) {
      attendeesTableBody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-[#9da7ba]">Aún no hay inscripciones para este taller.</td></tr>`;
      return;
    }

    attendances.forEach((att: any) => {
      const p = att.profiles;
      const fullName = p ? `${p.first_name} ${p.last_name}` : "Sin perfil asignado";
      const code = p?.student_code || "N/A";
      const userAlias = p?.username ? `@${p.username}` : "-";
      const career = p?.career || "N/A";

      const tr = document.createElement("tr");
      tr.className = "hover:bg-white/[0.02]";
      tr.innerHTML = `
        <td class="py-2.5 font-mono text-[#9da7ba]">${code}</td>
        <td class="py-2.5 font-medium text-white">${fullName}</td>
        <td class="py-2.5 font-mono text-astra-300 text-[11px]">${userAlias}</td>
        <td class="py-2.5 text-[#d1e4fa] text-[11px]">${career}</td>
        <td class="py-2.5 text-center">
          <input
            type="checkbox"
            data-attendance-id="${att.id}"
            ${att.attended ? "checked" : ""}
            class="attendance-checkbox h-4 w-4 rounded border-white/20 bg-space-950 text-astra-500 focus:ring-astra-400 focus:ring-offset-0 cursor-pointer"
          />
        </td>
      `;
      attendeesTableBody.appendChild(tr);
    });

    // Toggle de asistencia en tiempo real
    document.querySelectorAll(".attendance-checkbox").forEach(box => {
      box.addEventListener("change", async (e) => {
        const input = e.target as HTMLInputElement;
        const attId = input.getAttribute("data-attendance-id");
        const attendedState = input.checked;

        await supabase
          .from("workshop_attendances")
          .update({
            attended: attendedState,
            attended_at: attendedState ? new Date().toISOString() : null,
          })
          .eq("id", attId);

        // Actualizar métrica en el dashboard principal
        loadWorkshops();
      });
    });
  };

  // Inicialización
  (async () => {
    const isAllowed = await checkAdminAuth();
    if (isAllowed) {
      loadWorkshops();
    }
  })();
</script>