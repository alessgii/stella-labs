        { highlight: "rm -r:", text: "Elimina de forma recursiva. ¡Cuidado: en la terminal no hay papelera de reciclaje!" }
      ]
    },
    rightContent: {
      type: "terminal",
      title: "archivos.sh",
      lines: [
        "$ cd ~ && mkdir -p taller_linux/pruebas",
        "$ cd taller_linux/pruebas && touch notas.txt",
        "",
        "# Copiar y mover archivos:",
        "$ cp notas.txt copia.txt",
        "$ mv copia.txt respaldo.txt",
        "",
        "# Borrado directo:",
        "$ rm -r respaldo.txt"
      ]
    }
  },
  {
    id: 21,
    unitTheme: "amber",
    sessionBadge: "UNIDAD 03 // 45 MIN • EDICIÓN NANO",
    title: "Lectura y Edición de Archivos",
    subtitle: "Inspección rápida de contenido y edición en consola.",
    leftContent: {
      type: "points",
      items: [
        { highlight: "cat y head:", text: "cat imprime todo el archivo en pantalla; head muestra las primeras líneas." },
        { highlight: "Editor nano:", text: "Editor ligero de consola para modificar ficheros de texto plano y configuración." },
        { highlight: "Atajos clave:", text: "Presiona Ctrl+O para guardar y Ctrl+X para salir del editor." }
      ]
    },
    rightContent: {
      type: "terminal",
      title: "edicion.sh",
      lines: [
        "$ nano notas.txt",
        "",
        "# Dentro de nano:",
        "# Escribe tu contenido...",
        "# Ctrl+O -> guarda cambios",
        "# Ctrl+X -> sale al shell",
        "",
        "$ cat notas.txt && ls -l"
      ]
    }
  },
  {
    id: 22,
    unitTheme: "amber",
    sessionBadge: "UNIDAD 03 // 45 MIN • GESTOR APT",
    title: "Gestión de Paquetes con APT",
    subtitle: "Actualización e instalación de utilidades en Debian.",
    leftContent: {
      type: "points",
      items: [
        { highlight: "sudo apt update:", text: "Actualiza el catálogo local consultando la lista de versiones de los repositorios." },
        { highlight: "sudo apt install:", text: "Descarga e instala paquetes resolviendo dependencias (usar -y para confirmar)." },
        { highlight: "fastfetch:", text: "Herramienta moderna para desplegar métricas y datos del sistema en la terminal." }
      ]
    },
    rightContent: {
      type: "terminal",
      title: "actividad_guiada.sh",
      lines: [
        "# 1. Actualizar catálogo de repositorios:",
        "$ sudo apt update",
        "",
        "# 2. Instalar herramienta de métricas:",
        "$ sudo apt install -y fastfetch",
        "",
        "# 3. Ejecutar y visualizar información:",
        "$ fastfetch"
      ]
    }
  },

  // --- INTERMEDIA: UNIDAD 04 ---
  {
    id: 23,
    isUnitDivider: true,
    unitTheme: "emerald",
    unitNumber: "UNIDAD 04",
    sessionBadge: "SESIÓN 2 // 50 MIN • SERVICIOS Y DESPLIEGUE",
    title: "Servicios, Permisos y Despliegue Web",
    subtitle: "Instala y gestiona el servicio Apache con systemd, configura permisos POSIX en /var/www y despliega tu propio sitio web con Git.",
    unitTopics: [
      { number: "04.1", title: "Daemons y systemctl", desc: "Ciclo de vida de servicios en segundo plano con Apache2." },
      { number: "04.2", title: "Permisos POSIX", desc: "Gestión de chown $USER:www-data y permisos chmod 775." },
      { number: "04.3", title: "Despliegue y Red", desc: "Clonación con Git y acceso web mediante la dirección IP de la VM." }
    ]
  },
  // Contenido Unidad 4
  {
    id: 24,
    unitTheme: "emerald",
    sessionBadge: "UNIDAD 04 // 50 MIN • SERVICIO APACHE",
    title: "Servidor Web Apache y Daemons",
    subtitle: "Instalación y monitoreo de servicios con systemctl.",
    leftContent: {
      type: "points",
      items: [
        { highlight: "Daemon:", text: "Servicio en segundo plano que corre escuchando conexiones, administrado con systemctl." },
        { highlight: "Ruta de Apache:", text: "Por defecto, el servidor web Apache entrega contenido desde /var/www/html." },
        { highlight: "Verificación:", text: "Ejecuta systemctl status apache2 para revisar si está activo (pulsa 'q' para salir)." }
      ]
    },
    rightContent: {
      type: "terminal",
      title: "apache_setup.sh",
      lines: [
        "# Instalar servidor web y control de versiones:",
        "$ sudo apt install -y apache2 git",
        "",
        "# Verificar estado del servicio:",
        "$ systemctl status apache2",
        "# (Presiona 'q' para salir de la vista)"
      ]
    }
  },
  {
    id: 25,
    unitTheme: "emerald",
    sessionBadge: "UNIDAD 04 // 50 MIN • PERMISOS Y GIT",
    title: "Permisos, Redes y Despliegue",
    subtitle: "Ajuste de permisos con chmod/chown y clonado con Git.",
    leftContent: {
      type: "points",
      items: [
        { highlight: "Permisos rwx:", text: "Lectura, escritura y ejecución configurables por usuario, grupo y otros." },
        { highlight: "chown y chmod:", text: "Traspaso de propiedad a $USER:www-data y asignación de permisos seguros 775." },
        { highlight: "IP local y Git:", text: "Consulta tu dirección con ip a, clona tu repositorio con git clone y edita index.html." }
      ]
    },
    rightContent: {
      type: "terminal",
      title: "despliegue_web.sh",
      lines: [
        "# Corregir permisos en la ruta web:",
        "$ cd /var/www/html",
        "$ sudo chown -R $USER:www-data /var/www/html",
        "$ sudo chmod -R 775 /var/www/html",
        "",
        "# Reemplazar sitio por defecto:",
        "$ rm index.html && git clone <URL_REPO> .",
        "$ nano index.html",
        "",
        "# Verificar IP local de la VM:",
        "$ ip a"
      ]
    }
  },

  // --- INTERMEDIA: UNIDAD 05 ---
  {
    id: 26,
    isUnitDivider: true,
    unitTheme: "rose",
    unitNumber: "UNIDAD 05",
    sessionBadge: "SESIÓN 2 // 15 MIN • CIERRE & HORIZONTES",
    title: "Síntesis del Taller y Próximos Retos",
    subtitle: "Consolidación de las bases fundamentales de Linux, automatización y rutas recomendadas de especialización profesional.",
    unitTopics: [
      { number: "05.1", title: "Habilidades Conquistadas", desc: "Instalación limpia, administración CLI y servidores con systemd." },
      { number: "05.2", title: "Entornos Avanzados", desc: "Siguientes pasos en Dual-boot, VPS por SSH y contenedores Docker." },
      { number: "05.3", title: "Conclusión Práctica", desc: "Recursos y guía de consulta para tus proyectos universitarios." }
    ]
  },

  // 27. Recapitulación y Cierre
  {
    id: 27,
    isRecap: true,
    unitTheme: "rose",
    sessionBadge: "UNIDAD 05 // 15 MIN • RECAPITULACIÓN",
    title: "Recapitulación y Próximos Pasos",
    subtitle: "Conclusión de los objetivos alcanzados a lo largo del taller.",
    leftContent: {
      type: "points",
      items: [
        { highlight: "Lo que ya dominas:", text: "Instalar y dimensionar un sistema base Debian GNU/Linux en VM." },
        { highlight: "Manejo del entorno:", text: "Moverte con fluidez en GNOME y dominar la terminal CLI." },
        { highlight: "Administración:", text: "Gestionar paquetes con APT, permisos POSIX y servicios con systemd." }
      ]
    },
    rightContent: {
      type: "cards",
      cards: [
        { title: "Dual-boot", desc: "Particiones EFI junto a Windows en un mismo equipo físico para rendimiento nativo." },
        { title: "VPS Cloud", desc: "Administración de servidores remotos en la nube por SSH con llaves criptográficas." },
        { title: "Docker", desc: "Empaquetar aplicaciones web y microservicios sin conflictos de dependencias." }
      ]
    }
  }
];
---

<Layout title="StellaLabs — Taller: Introducción a Linux">
  <Header/>

  <div class="relative flex flex-col justify-between min-h-[calc(100vh-4rem)] overflow-hidden select-none bg-[#050508] text-slate-100">
    <!-- Barra de progreso superior dinámica -->
    <div class="w-full bg-slate-900/80 h-1 relative overflow-hidden z-30">
      <div 
        id="unit-progress-bar" 
        class="h-full transition-all duration-300 ease-out bg-gradient-to-r from-cyan-500 to-indigo-500"
        style="width: 3.7%;"
      ></div>
    </div>

    <main id="slide-container" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 flex flex-col justify-center relative z-10 touch-pan-y">
      {slides.map((slide, index) => {
        const theme = themeStyles[slide.unitTheme || 'cyan'];
        const isDiagram = slide.rightContent?.title?.endsWith('.txt') || slide.rightContent?.title?.endsWith('.map');

        return (
          <section 
            data-slide-index={index}
            data-theme={slide.unitTheme || 'cyan'}
            class={`slide-item transition-all duration-300 relative ${index === 0 ? 'block' : 'hidden'}`}
          >
            <!-- Ambient Glow Dinámico por Unidad -->
            <div class={`absolute -top-32 -right-32 w-80 sm:w-96 h-80 sm:h-96 ${theme.glow1} rounded-full blur-[100px] sm:blur-[130px] pointer-events-none transition-all duration-500`}></div>
            <div class={`absolute -bottom-32 -left-32 w-80 sm:w-96 h-80 sm:h-96 ${theme.glow2} rounded-full blur-[100px] sm:blur-[130px] pointer-events-none transition-all duration-500`}></div>

            {/* CASO 1: PORTADA */}
            {slide.isCover ? (
              <div class="max-w-3xl relative z-10">
                {slide.sessionBadge && (
                  <div class="mb-4">
                    <span class={`inline-flex items-center gap-1.5 text-[11px] font-mono tracking-wider uppercase px-3 py-1 rounded-full border ${theme.badge}`}>
                      <span class={`w-1.5 h-1.5 rounded-full ${theme.dot} animate-pulse`}></span>
                      {slide.sessionBadge}
                    </span>
                  </div>
                )}

                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-4">
                  Taller: <span class={`text-transparent bg-clip-text bg-gradient-to-r ${theme.gradient}`}>Introducción a Linux</span>
                </h1>
                <p class="text-slate-400 text-base sm:text-lg mb-8 leading-relaxed max-w-2xl">
                  {slide.subtitle}
                </p>

                {slide.leftContent?.items && (
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
                    {slide.leftContent.items.map((card) => (
                      <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-3.5 backdrop-blur-sm">
                        <span class="text-[10px] font-mono text-slate-500 uppercase block tracking-wider mb-1">{card.title}</span>
                        <span class="text-sm font-semibold text-slate-200">{card.text}</span>
                      </div>
                    ))}
                  </div>
                )}

                <div class="flex flex-wrap items-center gap-3">
                  <a 
                    href="/guias" 
                    class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-slate-800 bg-slate-900/80 hover:bg-slate-800 hover:text-white text-slate-300 font-medium text-sm transition-all active:scale-95 shadow-lg shadow-black/40 cursor-pointer"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Regresar
                  </a>

                  <button 
                    id="start-btn" 
                    class={`inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r ${theme.btnGradient} text-white font-medium text-sm transition-all shadow-lg active:scale-95 cursor-pointer`}
                  >
                    Comenzar Taller
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </button>
                </div>
              </div>

            /* CASO 2: DIAPOSITIVA INTERMEDIA DE CAMBIO DE UNIDAD */
            ) : slide.isUnitDivider ? (
              <div class="max-w-4xl mx-auto text-center py-6 sm:py-10 relative z-10">
                <div class="mb-4">
                  <span class={`inline-flex items-center gap-2 text-xs font-mono tracking-widest uppercase px-3.5 py-1.5 rounded-full border backdrop-blur-md ${theme.badge}`}>
                    <span class={`w-2 h-2 rounded-full ${theme.dot} animate-pulse`}></span>
                    {slide.sessionBadge}
                  </span>
                </div>

                <div class="mb-3">
                  <span class={`text-sm sm:text-base font-mono font-bold tracking-widest uppercase ${theme.textAccent}`}>
                    {slide.unitNumber}
                  </span>
                </div>

                <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-5 leading-tight">
                  <span class={`text-transparent bg-clip-text bg-gradient-to-r ${theme.gradient}`}>
                    {slide.title}
                  </span>
                </h2>

                <p class="text-slate-400 text-sm sm:text-base max-w-2xl mx-auto mb-10 leading-relaxed">
                  {slide.subtitle}
                </p>

                {slide.unitTopics && (
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-left max-w-3xl mx-auto">
                    {slide.unitTopics.map((topic) => (
                      <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-900/50 backdrop-blur-sm hover:border-slate-700 transition-all">
                        <span class={`text-xs font-mono font-semibold block mb-1.5 ${theme.textAccent}`}>{topic.number}</span>
                        <h4 class="text-sm font-semibold text-slate-200 mb-1">{topic.title}</h4>
                        <p class="text-xs text-slate-400 leading-relaxed">{topic.desc}</p>
                      </div>
                    ))}
                  </div>
                )}
              </div>

            /* CASO 3: DIAPOSITIVA ESTÁNDAR / RECAPITULACIÓN */
            ) : (
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center relative z-10">
                <div class="lg:col-span-5 space-y-4">
                  {slide.sessionBadge && (
                    <div class="mb-2">
                      <span class={`inline-flex items-center gap-1.5 text-[10px] sm:text-[11px] font-mono tracking-wider uppercase px-3 py-1 rounded-full border ${theme.badge}`}>
                        <span class={`w-1.5 h-1.5 rounded-full ${theme.dot} animate-pulse`}></span>
                        {slide.sessionBadge}
                      </span>
                    </div>
                  )}

                  <div>
                    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mb-2">{slide.title}</h2>
                    {slide.subtitle && (
                      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{slide.subtitle}</p>
                    )}
                  </div>

                  {slide.leftContent?.items && (
                    <ul class="space-y-3 pt-1">
                      {slide.leftContent.items.map((pt) => (
                        <li class="text-xs sm:text-sm text-slate-300 flex items-start gap-2.5 leading-relaxed">
                          <span class={`${theme.bullet} font-bold mt-0.5 text-base leading-none`}>•</span>
                          <span>
                            {pt.highlight && <strong class="text-white font-semibold">{pt.highlight} </strong>}
                            {pt.text}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}

                  {slide.isRecap && (
                    <div class="pt-4">
                      <a 
                        href="/guias"
                        class={`inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r ${theme.btnGradient} text-white font-medium text-sm transition-all shadow-lg active:scale-95 cursor-pointer`}
                      >
                        Finalizar
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                      </a>
                    </div>
                  )}
                </div>

                <div class="lg:col-span-7">
                  {slide.rightContent?.type === 'terminal' && (
                    <div class="rounded-xl overflow-hidden border border-slate-800/90 bg-[#0a0a12]/95 shadow-2xl shadow-black/80 backdrop-blur-md">
                      <div class="px-3.5 py-2.5 sm:px-4 bg-slate-900/80 border-b border-slate-800/80 flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                        </div>
                        <span class="text-[10px] sm:text-[11px] font-mono text-slate-400 truncate max-w-[200px] sm:max-w-none">{slide.rightContent.title}</span>
                        <span class={`text-[10px] font-mono ${theme.tag}`}>bash</span>
                      </div>
                      {/* Sin espacios entre <pre> y <code> para evitar desplazamiento en la primera línea. Comandos con wrapping en móvil para no forzar overflow */}
                      <pre class={`p-3.5 sm:p-5 font-mono text-slate-200 leading-relaxed ${
                        isDiagram 
                          ? 'text-[10px] xs:text-[11px] sm:text-xs overflow-x-auto whitespace-pre' 
                          : 'text-[11px] sm:text-xs whitespace-pre-wrap break-words sm:whitespace-pre sm:break-normal overflow-x-auto'
                      }`}><code>{slide.rightContent.lines?.join('\n')}</code></pre>
                    </div>
                  )}

                  {slide.rightContent?.type === 'checklist' && (
                    <div class="rounded-xl p-4 sm:p-5 border border-slate-800/80 bg-slate-900/40 backdrop-blur-md">
                      <span class={`text-xs font-mono uppercase tracking-wider block mb-4 ${theme.textAccent}`}>
                        {slide.rightContent.title}
                      </span>
                      <div class="space-y-3">
                        {slide.rightContent.items?.map((item) => (
                          <label class="flex items-center gap-3 p-3 rounded-lg bg-slate-950/60 border border-slate-800/60 text-xs sm:text-sm text-slate-200">
                            <input 
                              type="checkbox" 
                              checked={item.checked} 
                              class={`rounded border-slate-700 ${theme.checkbox} focus:ring-0 bg-slate-900 w-4 h-4 cursor-pointer`} 
                            />
                            <span>{item.label}</span>
                          </label>
                        ))}
                      </div>
                    </div>
                  )}

                  {slide.rightContent?.type === 'cards' && (
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      {slide.rightContent.cards?.map((card) => (
                        <div class="p-4 rounded-xl border border-slate-800/70 bg-slate-900/50 hover:border-slate-700/80 transition-all">
                          <h3 class={`text-sm font-semibold mb-1.5 ${theme.textAccent}`}>{card.title}</h3>
                          <p class="text-xs text-slate-400 leading-relaxed">{card.desc}</p>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )}
          </section>
        );
      })}
    </main>

    <!-- Footer de Navegación -->
    <footer class="w-full px-4 sm:px-8 py-4 flex items-center justify-between border-t border-slate-800/60 z-20 backdrop-blur-md bg-[#07070d]/70 text-xs font-mono">
      <button 
        id="prev-btn" 
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-slate-800 hover:bg-slate-800 text-slate-400 hover:text-white transition-all active:scale-95 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span id="prev-btn-text">Regresar</span>
      </button>

      <div class="flex items-center gap-2 text-slate-500 font-medium">
        <span id="current-slide" class="text-slate-200">1</span>
        <span> / </span>
        <span>{slides.length}</span>
      </div>

      <button 
        id="next-btn" 
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-slate-800 hover:bg-slate-800 text-slate-400 hover:text-white transition-all active:scale-95 cursor-pointer"
      >
        <span id="next-btn-text">Siguiente</span>
        <svg id="next-btn-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </footer>
  </div>

  <script is:inline define:vars={{ totalSlides: slides.length, slideThemes: slides.map(s => s.unitTheme || 'cyan') }}>
    let currentSlide = 0;
    const slidesEl = document.querySelectorAll('.slide-item');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const prevBtnText = document.getElementById('prev-btn-text');
    const nextBtnText = document.getElementById('next-btn-text');
    const nextBtnIcon = document.getElementById('next-btn-icon');
    const currentSlideEl = document.getElementById('current-slide');
    const startBtn = document.getElementById('start-btn');
    const progressBar = document.getElementById('unit-progress-bar');

    const gradientMap = {
      cyan: 'from-cyan-500 to-indigo-500',
      purple: 'from-purple-500 to-indigo-500',
      amber: 'from-amber-500 to-orange-500',
      emerald: 'from-emerald-500 to-teal-500',
      rose: 'from-rose-500 to-pink-500'
    };

    function updateSlide(index) {
      if (index < 0 || index >= totalSlides) return;
      currentSlide = index;

      slidesEl.forEach((el, i) => {
        if (i === currentSlide) {
          el.classList.remove('hidden');
          el.classList.add('block');
        } else {
          el.classList.add('hidden');
          el.classList.remove('block');
        }
      });

      if (currentSlideEl) currentSlideEl.textContent = String(currentSlide + 1);

      // Actualizar barra de progreso con color dinámico de la unidad
      if (progressBar) {
        const pct = ((currentSlide + 1) / totalSlides) * 100;
        progressBar.style.width = pct + '%';
        const currentTheme = slideThemes[currentSlide] || 'cyan';
        progressBar.className = `h-full transition-all duration-300 ease-out bg-gradient-to-r ${gradientMap[currentTheme] || gradientMap.cyan}`;
      }

      // Estado botón Anterior / Regresar
      if (currentSlide === 0) {
        if (prevBtnText) prevBtnText.textContent = "Regresar";
      } else {
        if (prevBtnText) prevBtnText.textContent = "Anterior";
      }

      // Estado botón Siguiente / Finalizar
      if (currentSlide === totalSlides - 1) {
        if (nextBtnText) nextBtnText.textContent = "Finalizar";
        if (nextBtn) {
          nextBtn.classList.add('bg-gradient-to-r', 'from-rose-600', 'to-indigo-600', 'text-white', 'border-transparent');
          nextBtn.classList.remove('text-slate-400', 'border-slate-800');
        }
        if (nextBtnIcon) {
          nextBtnIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>';
        }
      } else {
        if (nextBtnText) nextBtnText.textContent = "Siguiente";
        if (nextBtn) {
          nextBtn.classList.remove('bg-gradient-to-r', 'from-rose-600', 'to-indigo-600', 'text-white', 'border-transparent');
          nextBtn.classList.add('text-slate-400', 'border-slate-800');
        }
        if (nextBtnIcon) {
          nextBtnIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>';
        }
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentSlide === 0) {
          window.location.href = '/guias';
        } else {
          updateSlide(currentSlide - 1);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentSlide === totalSlides - 1) {
          window.location.href = '/guias';
        } else {
          updateSlide(currentSlide + 1);
        }
      });
    }

    if (startBtn) {
      startBtn.addEventListener('click', () => updateSlide(1));
    }

    // Navegación con teclado
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        if (currentSlide < totalSlides - 1) updateSlide(currentSlide + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        if (currentSlide > 0) updateSlide(currentSlide - 1);
      }
    });

    // Control táctil para móviles (Swipe horizontal)
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;

    const mainContainer = document.getElementById('slide-container');

    if (mainContainer) {
      mainContainer.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }, { passive: true });

      mainContainer.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].clientX;
        touchEndY = e.changedTouches[0].clientY;
        handleSwipeGesture();
      }, { passive: true });
    }

    function handleSwipeGesture() {
      const deltaX = touchEndX - touchStartX;
      const deltaY = touchEndY - touchStartY;
      const minDistance = 45; // Distancia mínima en px

      if (Math.abs(deltaX) > Math.abs(deltaY) * 1.2 && Math.abs(deltaX) > minDistance) {
        if (deltaX < 0) {
          // Deslizar hacia la izquierda -> Avanzar
          if (currentSlide < totalSlides - 1) {
            updateSlide(currentSlide + 1);
          }
        } else {
          // Deslizar hacia la derecha -> Retroceder
          if (currentSlide > 0) {
            updateSlide(currentSlide - 1);
          }
        }
      }
    }

    updateSlide(0);
  </script>
</Layout>