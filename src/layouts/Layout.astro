---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "StellaLabs" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="StellaLabs." />
    <title>{title}</title>
  </head>
  <body class="bg-dark flex min-h-screen flex-col font-sans text-white antialiased">
    <slot />
  </body>
</html>
